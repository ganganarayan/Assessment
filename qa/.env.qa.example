# Copy to qa/.env.qa (gitignored) and fill in. Every value is optional: anything
# missing falls back to the process environment, so `railway run npm run qa -- --slug=x`
# works with no file at all, because Railway injects the database URLs itself.
#
# The file is the standing default and the ENVIRONMENT overrides it, so a one-off run can
# point somewhere else without editing anything:
#   QA_BASE_URL=https://assess.applygitawisdom.com npm run qa:screens -- --only=legal

# The funnel's public origin. Staging by default; the harness refuses a production
# host unless you pass --i-know-this-is-prod.
QA_BASE_URL=https://orbitq-assess.applygitawisdom.com

# Staging Postgres, reachable from a laptop. This is DATABASE_PUBLIC_URL from the
# Railway Postgres service, NOT the .railway.internal host (that name only resolves
# inside Railway). Leave blank when running under `railway run`.
QA_DATABASE_URL=

# Admin login used ONLY by the admin-screen pass (--admin). The harness types these
# into the staging login form at runtime; they are never written into code, never
# logged, and this file is gitignored. Use a staging-only account.
QA_ADMIN_EMAIL=
QA_ADMIN_PASSWORD=

# Where test identities come from. Every case gets a unique address built from this
# so the retake lockout never blocks a sweep, and so test rows are trivially
# separable from real ones. Use a domain you control or one that black-holes mail:
# SMTP is live on staging, and some funnel paths really do send.
QA_EMAIL_DOMAIN=qa.invalid
QA_MOBILE_PREFIX=99900

# Optional: a webhook catcher (webhook.site or similar) you have configured on the
# tenant, so payload assertions have something to read back.
QA_WEBHOOK_CATCHER=
