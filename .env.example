# ---------------------------------------------------------------------------
# Assessment Engine SaaS — Environment Variables
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# ---------------------------------------------------------------------------

# --- Core ------------------------------------------------------------------
NODE_ENV=development

# Root domain used for tenant subdomains, e.g. acme.example.com
# In local dev use "lvh.me:3000" (resolves to 127.0.0.1) or "localhost:3000".
NEXT_PUBLIC_ROOT_DOMAIN=lvh.me:3000

# Public base URL of the application (no trailing slash).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Comma-separated origins allowed to call Server Actions (custom domains).
ALLOWED_ORIGINS=http://localhost:3000

# MVP: email treated as the platform owner / super admin (overrides DB role).
PLATFORM_OWNER_EMAIL=ganganarayan.rns@gmail.com

# --- Database (PostgreSQL) -------------------------------------------------
# Railway provides DATABASE_URL automatically when a Postgres plugin is added.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/assessment?schema=public

# --- Better Auth -----------------------------------------------------------
# Generate a strong secret: `openssl rand -base64 32`
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
BETTER_AUTH_URL=http://localhost:3000

# --- Cloudflare R2 (S3-compatible) — OPTIONAL in Phase 1 -------------------
# The app boots fine without these. They are only validated lazily when a
# storage operation is actually invoked. Leave unset until uploads are needed.
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=assessment-engine
# Public bucket URL (custom domain or r2.dev), no trailing slash.
R2_PUBLIC_URL=https://assets.example.com
