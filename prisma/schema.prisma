// Assessment Engine SaaS - Prisma Schema (Phase 1)
// Only foundation models: Tenant, Domain, Theme, User (+ Better Auth tables).
// Assessment / Category / Question models arrive in Phase 2.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Roles
// ---------------------------------------------------------------------------

enum Role {
  SUPER_ADMIN // Owner of the whole platform (the app creator). Global scope.
  ADMIN // Administrator of a single tenant workspace. Logs in with their email.
}

// Staff permission. NULL on a User = full-access owner/admin (unchanged behaviour).
// A staff member is a User with this set: VIEW = read-only everywhere in their
// scope; EDIT = may edit content/config in their scope, but NEVER manage staff or
// touch their owner. Platform staff have role SUPER_ADMIN (all-tenant visibility);
// tenant staff have role ADMIN + a tenantId.
enum StaffPermission {
  VIEW
  EDIT
}

// ---------------------------------------------------------------------------
// Tenant - the core multi-tenancy boundary. Everything scopes to a Tenant.
// ---------------------------------------------------------------------------

model Tenant {
  // End of the 14-day Signal trial. Null = never trialled (or already converted).
  // Past this, with no active subscription, the tenant is PARKED: read-only, funnel
  // paused, data kept. Never deleted.
  trialEndsAt DateTime?

  /// When StartTrial was reported to Meta for this workspace. Set once, on the first
  /// time anyone from the workspace reaches the app after signing up.
  ///
  /// Per WORKSPACE, not per user: a second staff member logging in is not a second
  /// trial. And a stamp rather than "fire on login", because a returning owner opens
  /// the dashboard every day and none of those are a trial starting.
  startTrialFiredAt DateTime?

  id        String       @id @default(cuid())
  // Unique subdomain slug, e.g. "acme" -> acme.example.com
  slug      String       @unique
  name      String
  status    TenantStatus @default(ACTIVE)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  // Soft delete. Deleting a tenant from the platform console sets this instead of
  // removing the row: the tenant disappears from the active list, its logins can no
  // longer reach the workspace, its custom domains stop resolving and its assessments
  // stop serving - but every assessment, lead, payment and setting is still there, so
  // Restore puts the whole business back exactly as it was.
  //
  // The permanent, cascading delete is a SECOND action available only from the deleted
  // list. That two-stage shape is the safety: one mis-click can never destroy a
  // tenant's data, because the destructive step is only reachable from a list you have
  // to go looking in, and still demands the slug typed out in full.
  deletedAt DateTime?

  // Billing (Phase 1). The SaaS subscription plan for THIS tenant, billed on the
  // PLATFORM-OWNER's Razorpay account in USD (NOT the tenant's own respondent keys).
  // Default FREE. Changed only by the Razorpay subscription webhook or a super-admin
  // override - never trusted from the client. razorpayCustomerId links this tenant to
  // its Razorpay customer across the subscription lifecycle. The PLATFORM tenant is a
  // real row here (id "platform", seeded by migration) and carries SCALE, but code
  // short-circuits it to unlimited/unmetered regardless - the platform is not a
  // customer of itself. See src/lib/tenant/platform-tenant.ts.
  // 🟡 NOT consulted by resolution. resolvePlan reads the SUBSCRIPTION (and the trial);
  // a tenant with neither is parked. This column records the last plan transacted, for
  // reporting - setting it by hand entitles nobody. Use Tenant.unlimited for an internal
  // workspace that should bypass the catalog.
  plan               Plan    @default(GATE)
  razorpayCustomerId String?

  // MANUAL ACCESS GRANT: `plan` above applies until this moment, then the tenant parks.
  // Null = no grant at all, which is every existing row and therefore no change in
  // behaviour. The date is what makes a grant a grant: `plan` defaults to GATE on every
  // tenant, so treating the column alone as an entitlement would hand a free plan to
  // every parked workspace on the install.
  //
  // This is how a trial gets extended by hand and how an account is comped: set the
  // plan, set the date. It sits BELOW a paid subscription deliberately - a tenant who
  // is paying is entitled by what they pay for, and a stale date must never be able to
  // downgrade them - and ABOVE the trial, so extending someone mid-trial works by
  // naming a later date rather than by editing the trial.
  planExpiresAt DateTime?

  // INTERNAL tenant: one the platform owner runs themselves rather than sells to.
  // Resolves to unlimited limits and every feature on, exactly like the platform -
  // no plan, no subscription, no metering, no feature gate.
  //
  // This exists because the owner operates several of their own businesses on this
  // install. Without it each one has to be parked on a paid plan it will never be
  // billed for, and any that is missed silently loses Meta CAPI and locks at 25
  // responses a month - which, on a tenant running paid ads, is money lost with no
  // error anywhere. A flag states the intent; a fake SCALE plan only implies it.
  unlimited Boolean @default(false)

  // Per-tenant respondent-payment switch, set by the platform owner. Default TRUE, so
  // nothing changes for a tenant already taking money. Turned off, this tenant's
  // funnels run free: the payment step is not offered and paid mode is forced off when
  // the public assessment is resolved, rather than failing at the moment someone tries
  // to pay. ANDed with AppSetting.paymentsEnabledGlobal on the singleton, which is the
  // master; the per-assessment paidMode remains the most specific switch of the three.
  paymentsEnabled Boolean @default(true)

  // Per-tenant AI model override, set by the platform owner. Wins over the per-plan
  // binding for this one tenant - the Enterprise negotiation, or an account worth more
  // than a Haiku statement. Null = use the plan binding.
  aiModelOverride String?

  // The assessment served at this tenant's own root (its subdomain or a custom
  // domain). Null = fall back to the tenant's only published assessment; with several
  // published and none chosen, the root keeps its generic page rather than guessing.
  primaryAssessmentId String?

  // Acquisition attribution - the ad/campaign this tenant (a self-serve signup) came
  // from, captured from the last-touch UTM cookie at signup. The full set is kept as
  // JSON; the common fields are denormalized for fast grouping in the platform funnel
  // dashboard. Null = organic / pre-dating this tracking.
  acquisitionAttribution Json?
  acqUtmSource           String?
  acqUtmMedium           String?
  acqUtmCampaign         String?
  acqUtmTerm             String?
  acqUtmContent          String?

  // AGENCY TENANTS (2026-10-13). Set = this workspace belongs to an AGENCY ADMIN, and
  // the value is the tenant id of that agency admin's own workspace. Null = a tenant
  // directly under the super admin, which is every existing row - so nothing is
  // backfilled and nothing changes for anyone already on the install.
  //
  // Depth is ONE by design: an agency tenant resolves no agencyTenants allowance of
  // its own (PLAN_LIMITS + assertCanCreateAgencyTenant), so a workspace under an
  // agency admin can never resell a workspace under itself.
  //
  // 🔴 onDelete: Restrict, deliberately. The platform's permanent delete cascades a
  // tenant's OWN rows on purpose, but cascading from here would destroy five separate
  // businesses because one agency account was deleted. Restrict makes the operator
  // deal with the agency tenants first, with an error instead of silence.
  agencyAdminTenantId String?
  agencyAdmin         Tenant?  @relation("AgencyTenants", fields: [agencyAdminTenantId], references: [id], onDelete: Restrict)
  agencyTenants       Tenant[] @relation("AgencyTenants")

  users                User[]
  domains              Domain[]
  theme                Theme?
  assessments          Assessment[]
  submissions          Submission[]
  apiTokens            ApiToken[]
  webhooks             Webhook[]
  webhookLogs          WebhookLog[]
  payments             Payment[]
  aiUsage              AiUsage[]
  capiLogs             CapiLog[]
  setting              AppSetting?
  promptVersions       AiPromptVersion[]
  subscription         Subscription?
  usageCounters        UsageCounter[]
  nurtureLogs          NurtureLog[]
  paymentHandoffs      PaymentHandoff[]
  paymentLinks         PaymentLink[]
  /// Templates PRIVATE to this workspace (saved from the builder, never contributed).
  ownedTemplates       Template[]              @relation("TemplateOwner")
  /// Templates this workspace sent to the master library.
  contributedTemplates Template[]              @relation("TemplateContributor")
  adAccounts           AdAccount[]
  supportRequests      SupportRequest[]
  audienceLists        AudienceList[]
  /// Result pages (RESULTS + VSL) in this workspace's library.
  resultPageDocs       ResultPageDoc[]
  /// What this workspace has answered in the guided setup sequence.
  onboardingAnswers    OnboardingAnswer[]
  /// What this workspace offers for 1:1 booking, and the appointments in its calendar.
  bookingTypes         BookingType[]
  appointments         Appointment[]
  googleCalendars      GoogleCalendarAccount[]
  automations          Automation[]
  contacts             Contact[]
  workflows            Workflow[]
  tags                 Tag[]

  @@index([status])
  @@index([deletedAt])
  @@index([agencyAdminTenantId])
  @@map("tenant")
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
}

// ---------------------------------------------------------------------------
// Billing (Phase 1) - SaaS subscription plan + usage metering. Phase 1 stores
// state only; NOTHING is enforced yet (Phase 2 meters, Phase 4 gates). The plan
// LIMITS themselves live in code (src/lib/billing/plans.ts) as the source of
// truth; Subscription.limitsSnapshot freezes them at purchase time so a future
// price/limit change never silently re-rates an existing customer (this is what
// backs the "founding cohort locks this rate for life" promise).
// ---------------------------------------------------------------------------

enum Plan {
  // Legacy values. Postgres cannot drop an enum value without a full type swap, so the
  // old names stay in the type and leave the catalog (PLAN_IDS) instead.
  FREE
  STARTER
  GROWTH
  SCALE
  // Current catalog.
  GATE
  SIGNAL
  AGENCY
  ENTERPRISE
}

// Mirrors the Razorpay subscription lifecycle we care about. ACTIVE = paid & good;
// PAST_DUE = a charge failed, still in grace; PENDING = awaiting first auth/charge;
// HALTED = Razorpay gave up retrying (treat as lapsed); CANCELED = ended.
enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  PENDING
  HALTED
  CANCELED
}

// Metered usage dimensions. Only RESPONSES is metered per-period (the hot path,
// incremented on each submission). Assessments and seats are COUNT()ed on demand,
// so they are NOT enumerated here.
enum UsageMetric {
  RESPONSES
}

// ---------------------------------------------------------------------------
// Domain - custom domains mapped to a tenant for white-label hosting.
// ---------------------------------------------------------------------------

model Domain {
  id        String  @id @default(cuid())
  // Full hostname, e.g. "assess.acme.com"
  hostname  String  @unique
  isPrimary Boolean @default(false)
  verified  Boolean @default(false)

  // Railway custom-domain provisioning. When RAILWAY_API_TOKEN is configured the app
  // registers this host with Railway (customDomainCreate) so Railway issues the TLS
  // cert. railwayDomainId = the Railway domain id (for status polling + delete),
  // dnsTarget = the CNAME value Railway wants the tenant to point at, certStatus =
  // the last-seen Railway certificate status (e.g. "ISSUED"/"ISSUING").
  railwayDomainId String?
  // Cloudflare for SaaS custom-hostname id. When set, TLS + routing for this host are
  // handled by Cloudflare's custom-hostname edge rather than a Railway custom domain -
  // which is what lifts the per-service domain cap on the Railway plan. Null for hosts
  // provisioned the old way (Railway custom domain) or added manually.
  cfHostnameId    String?
  dnsTarget       String?
  certStatus      String?
  // The DNS records the domain owner must add at their provider, as returned by
  // Railway (normalized: [{ type, name, value, purpose, status }]). Persisted so the
  // settings page can show them without re-hitting Railway on every load; refreshed
  // on add + "Check status". Null on rows created before this shipped.
  dnsRecords      Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("domain")
}

// ---------------------------------------------------------------------------
// Theme - per-tenant branding/presentation config (kept independent of logic).
// ---------------------------------------------------------------------------

model Theme {
  id             String   @id @default(cuid())
  primaryColor   String   @default("#0f172a")
  secondaryColor String   @default("#64748b")
  logoUrl        String?
  faviconUrl     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenantId String @unique
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("theme")
}

// ---------------------------------------------------------------------------
// Subscription - ONE per paid tenant. The Razorpay subscription is the source of
// truth for status/period; this row mirrors it so the app can gate without a
// Razorpay round-trip. A FREE tenant has NO Subscription row (absence = Free).
// ---------------------------------------------------------------------------

model Subscription {
  id     String             @id @default(cuid())
  plan   Plan
  status SubscriptionStatus @default(PENDING)

  // Razorpay linkage (platform-owner account, USD). All nullable until the first
  // checkout completes and the webhook fills them in.
  razorpaySubscriptionId String? @unique
  razorpayPlanId         String?

  // Current billing period, copied from Razorpay. Also the window the RESPONSES
  // usage counter resets on for a paid tenant (Free tenants use the calendar month).
  //
  // 🔴 THESE CAN BE NULL FOREVER. They are only ever written by the webhook, so a
  // subscription activated by the browser returning from Checkout has none. That is
  // why paidAt/renewsAt below exist and are the fields the app actually displays:
  // a renewal date that only exists when a webhook arrives is not a billing record.
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?

  /// When this subscription was last PAID, from the confirmation the app itself
  /// received. Written by both paths: /verify (the browser returning with a signed
  /// payment id) and the subscription.charged webhook.
  paidAt DateTime?

  /// When it renews next, COMPUTED BY US from paidAt - the same day of the month,
  /// clamped to the last day in shorter months. Never waits on Razorpay, so the app
  /// can always answer "when does this renew" (see lib/billing/renewal.ts).
  renewsAt DateTime?

  /// The Razorpay payment id of the last successful charge. The confirmation the
  /// customer can quote back, and the join key to the Payment ledger row.
  lastPaymentId     String?
  cancelAtPeriodEnd Boolean @default(false)

  seats Int @default(1)

  // AGENCY-TENANT SLOTS bought beyond the plan's included count ($29/mo each), and the
  // SECOND Razorpay subscription that carries them. Two subscriptions rather than a
  // quantity on the first, because quantity multiplies the BASE price: 249 x 2 is not
  // 249 + 29. This column is the number CONFIRMED PAID - the webhook writes it, never
  // the client - and the cap is included + this.
  extraAgencyTenants         Int     @default(0)
  razorpaySlotSubscriptionId String? @unique

  // CUSTOM DOMAINS bought beyond the one every workspace includes ($5/mo each). Additive
  // on top of PlanLimits.customDomains, which is what makes it an add-on rather than a
  // negotiated deal - limitOverrides REPLACES the plan's number, so it could never
  // express "one more than whatever they are on".
  extraCustomDomains Int @default(0)

  // Entitlements FROZEN at purchase (a copy of PLAN_LIMITS for `plan`). Resolution
  // reads this first so a later catalog change never re-rates this customer.
  limitsSnapshot Json
  // Optional per-tenant overrides for one-off/enterprise deals - wins over the
  // snapshot AND the code default. Null for everyone normally.
  limitOverrides Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenantId String @unique
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("subscription")
}

// ---------------------------------------------------------------------------
// UsageCounter - metered usage per tenant, per metric, per period. RESPONSES is
// incremented on each submission (Phase 2). periodKey = the billing-period start
// (paid) or "YYYY-MM" calendar month (Free), so a new period starts a fresh row
// at count 0. A nightly job reconciles counts against Submission.
// ---------------------------------------------------------------------------

model UsageCounter {
  id        String      @id @default(cuid())
  metric    UsageMetric
  periodKey String
  count     Int         @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, metric, periodKey])
  @@index([tenantId])
  @@map("usage_counter")
}

// ---------------------------------------------------------------------------
// BillingEvent - idempotency ledger for Razorpay subscription webhooks. Every
// processed event id is recorded so a redelivery is a no-op. Same discipline as
// the CAPI/webhook dedupe elsewhere.
// ---------------------------------------------------------------------------

model BillingEvent {
  id          String   @id @default(cuid())
  // Razorpay webhook event id (x-razorpay-event-id header), globally unique.
  eventId     String   @unique
  type        String
  processedAt DateTime @default(now())

  @@index([type])
  @@map("billing_event")
}

// ---------------------------------------------------------------------------
// RazorpayPlan - cache of the Razorpay Plan objects we create via the API at
// runtime (the VidaPulse model: no Plans are hand-made in the dashboard). Keyed
// by our PlanId; created once on the first checkout for that tier and reused on
// every subsequent subscription. Platform-level (billed on the platform-owner's
// Razorpay account in USD), so it is a small global table, not per-tenant.
// ---------------------------------------------------------------------------

// ---------------------------------------------------------------------------
// PlatformPageView - analytics for the Assess360 SaaS MARKETING landing (the root
// site). Parallel to PageView (which is assessment-scoped): this one has no
// assessment - it tracks the top of the SaaS funnel (landing views + UTM) before
// any signup, so ad traffic is visible even with zero conversions. Feeds the
// super-admin platform funnel dashboard.
// ---------------------------------------------------------------------------

model PlatformPageView {
  id        String   @id @default(cuid())
  visitorId String
  path      String?
  createdAt DateTime @default(now())

  utmSource    String?
  utmMedium    String?
  utmCampaign  String?
  utmTerm      String?
  utmContent   String?
  fbclid       String?
  gclid        String?
  referrerHost String?

  // Bot flag (excluded from human-facing metrics) + enrichment, mirroring PageView.
  isBot      Boolean @default(false)
  userAgent  String?
  ip         String?
  country    String?
  city       String?
  region     String?
  deviceType String?
  browser    String?
  os         String?

  @@index([createdAt])
  @@index([visitorId])
  @@index([utmSource])
  @@index([utmCampaign])
  @@map("platform_page_view")
}

model RazorpayPlan {
  // Our plan id ("STARTER" | "GROWTH" | "SCALE") - never FREE (nothing to charge).
  planKey        String @id
  razorpayPlanId String @unique
  // The amount the Razorpay Plan was created with, in the smallest USD unit (cents),
  // so a later price change is detectable (a mismatch means: create a new Plan).
  amountCents    Int
  currency       String @default("USD")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("razorpay_plan")
}

// ---------------------------------------------------------------------------
// User - application users. The platform OWNER is SUPER_ADMIN and belongs to the
// Platform tenant; super-admin access comes from the role, never from the tenant
// (lib/auth/guards isSuperAdmin), so attaching a tenant costs no access. Rows still
// carrying tenantId = null pre-date the re-home.
// Fields below also satisfy Better Auth's "user" model contract.
// ---------------------------------------------------------------------------

model User {
  id                 String           @id @default(cuid())
  name               String
  email              String           @unique
  emailVerified      Boolean          @default(false)
  image              String?
  role               Role             @default(ADMIN)
  // NULL = full-access owner/admin. Set = staff member (VIEW read-only / EDIT).
  staffPermission    StaffPermission?
  // Soft delete: set = removed (hidden from active logins, unassigned from tenant,
  // sessions revoked) but recoverable from the "Deleted users" section.
  deletedAt          DateTime?
  // TRUE after a super admin sets the password - the user is forced to change it on
  // next login before reaching the app; cleared once they set their own.
  mustChangePassword Boolean          @default(false)
  /// When this login last signed in. Stamped by the session-create hook in auth.ts,
  /// which is the one event that means "a human got in" - updatedAt does not, because
  /// any profile write moves it.
  ///
  /// A column and not a query over `session`, because sessions expire and are pruned:
  /// reading the newest session row would turn a tenant who logged in two months ago
  /// into one who has never logged in, which is the opposite of what this is for.
  /// Null = no sign-in since the column was added.
  lastLoginAt        DateTime?
  /// How many times this login has signed in. Incremented by the same session-create
  /// hook that stamps lastLoginAt.
  ///
  /// A FLOOR, not a lifetime total: it was backfilled from surviving session rows, and
  /// expired sessions had already been pruned. Beside the date it answers the question
  /// a date alone cannot - whether somebody looked once and left, or comes back daily
  /// and still has not shipped anything.
  loginCount         Int              @default(0)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  // Null for SUPER_ADMIN (platform-wide); set for ADMIN (tenant-scoped).
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  /// How this login is reached on WhatsApp, in any readable form (the sender
  /// normalises it to E.164 digits). Optional, and the support thread SAYS so when it
  /// is blank: a reply then goes out by email only.
  ///
  /// On the USER and not the tenant, because the person who raised a ticket is the
  /// person who wants telling it was answered, and a workspace with two logins has two
  /// different people with two different phones.
  whatsapp String?

  sessions           Session[]
  accounts           Account[]
  createdAssessments Assessment[]
  supportRequests    SupportRequest[]
  supportMessages    SupportMessage[]
  /// This staff member's own calendar: the booking links that sell their time, and the
  /// appointments sitting in their diary.
  bookingTypes       BookingType[]           @relation("StaffBookingTypes")
  googleCalendars    GoogleCalendarAccount[] @relation("StaffGoogleCalendars")
  appointments       Appointment[]           @relation("StaffAppointments")

  @@index([tenantId])
  @@map("user")
}

// ---------------------------------------------------------------------------
// Better Auth required tables (auth plumbing, not domain models).
// ---------------------------------------------------------------------------

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ---------------------------------------------------------------------------
// ApiToken - scoped, tenant-aware bearer tokens for external data endpoints
// (the shared auth layer behind /api/meta-match and future consumers like a
// mentor API). Only the sha256 `tokenHash` is stored; the plaintext is shown to
// the admin once at mint time. `scope` binds a key to ONE data domain (least
// privilege): a meta_match key can never read another scope's data. `tenantId`
// null = platform-owned; set = the key only sees that tenant's rows.
// ---------------------------------------------------------------------------

model ApiToken {
  id          String    @id @default(cuid())
  tokenHash   String    @unique // sha256(plaintext); the plaintext is never stored
  prefix      String // non-secret identifier shown in the admin list, e.g. mm_ABC234
  scope       String // "meta_match" (future: "gita_mentor", ...)
  label       String?
  lastUsedAt  DateTime?
  revokedAt   DateTime?
  createdById String?
  createdAt   DateTime  @default(now())

  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([scope])
  @@index([tenantId])
  @@map("api_token")
}

// ===========================================================================
// Assessment Engine (MVP)
// ===========================================================================

enum AssessmentStatus {
  DRAFT
  PUBLISHED
}

enum QuestionType {
  SINGLE_SELECT
  // Typed answer, no options. Scores nothing (excluded from the engine and from the
  // category maximum) and routes by the question's default route, because there is no
  // chosen option to hang a rule on. Added for surveys whose value IS the sentence
  // somebody types, e.g. the cancellation exit assessment.
  FREE_TEXT
}

enum BandLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum SubmissionStatus {
  STARTED
  COMPLETED
}

enum RetakePolicy {
  DELAYED // block retakes within retakeDays; allow after
  NEVER // one submission per identifier, ever
  UNLIMITED // immediate retakes allowed
}

enum UniqueIdentifier {
  EMAIL
  MOBILE
}

// How the assessment's questions are shown to the respondent.
enum QuestionDisplayMode {
  ALL // every question on one page
  CATEGORY // one page per category
  SINGLE // one question per page (with its category name)
}

// Which scoring/result engine an assessment uses. GENERIC = the built-in
// category-weight scorer (all existing funnels). CLINIC_AUDIT = the data-driven
// patient-acquisition funnel model (E×B×S×C…) with the interactive result page.
// Additive: everything defaults to GENERIC so existing assessments are unchanged.
enum AssessmentEngine {
  GENERIC
  CLINIC_AUDIT
}

// WHEN the lead fields are asked for.
//
// ALL_AT_ONCE is every funnel that exists today: one opt-in screen holding every
// field, placed before or after the questions by leadCaptureAfter.
//
// SPLIT asks in stages - name, then the gate, then email the moment they qualify,
// then the assessment, then phone one tap before the result. It exists because a
// fifteen-minute application loses people half way through, and today an abandoner
// leaves no contact at all. The two modes run through different code in the runner,
// so choosing ALL_AT_ONCE is not a configuration that behaves like today: it IS today.
enum LeadCaptureMode {
  ALL_AT_ONCE
  SPLIT
}

// The step the flow moves to after the Results page. Explicit binding - every
// flow must resolve to one. paidMode is kept in sync (PAYMENT => paidMode on).
enum NextStep {
  PAYMENT // take payment (Razorpay), then the destination
  DESTINATION // go straight to the destination/VSL (no payment)
  RESULTS // show the results on assess360's own result page (no external VSL redirect)
  // Nothing is shown back. The run ends on the thank-you message: answers are stored,
  // the webhook fires, no score, no page, no redirect. For a funnel whose value is the
  // ANSWERS rather than the result - a survey, a feedback form, the cancellation exit -
  // where a scorecard is at best noise and at worst insulting.
  NO_RESULT
}

// ---------------------------------------------------------------------------
// Assessment - the top-level container. Public at /a/[slug] when PUBLISHED.
// ---------------------------------------------------------------------------

model Assessment {
  /// Which ad account this funnel reports to. NULL means the tenant's default, which is
  /// why no backfill is needed: every existing assessment keeps working untouched.
  adAccountId String?
  adAccount   AdAccount? @relation(fields: [adAccountId], references: [id], onDelete: Restrict)

  // Platform signup funnel: after the lead form and the completion event, send the
  // person to /sign-up prefilled with their email instead of a result page. Only
  // honoured on a PLATFORM-owned assessment - a tenant must never be able to mint
  // logins on the SaaS itself.
  platformSignup Boolean @default(false)
  id             String  @id @default(cuid())
  slug           String  @unique
  title          String
  // Opt-in hero copy shown around the headline (title): eyebrow is a small kicker
  // ABOVE it, subheadline a secondary line BELOW it. Both optional; null = hidden.
  eyebrow        String?
  subheadline    String?
  description    String?
  coverImageUrl  String?

  // Funnel CTA styling: primary-button background + text colour (hex, e.g. "#16a34a").
  // Null = the default green/white theme, so existing funnels are unchanged.
  buttonColor     String?
  buttonTextColor String?

  // Per-assessment heatmap/session-recording snippet (e.g. MS Clarity), set in the
  // builder. Injected on THIS assessment's funnel; null/blank falls back to the tenant's
  // Settings-level snippet (resolveHeatmapCode), so a workspace default still applies.
  heatmapCode String?

  // Optional "pre-results" data-capture page shown AFTER the questions, BEFORE the
  // results. preResultFields = ordered JSON [{ id, label, type: "text"|"select",
  // options: string[], required: boolean }]. Null/empty = no extra page (unchanged flow).
  preResultHeading String?
  preResultSubtext String?
  preResultFields  Json?
  status           AssessmentStatus @default(DRAFT)
  estimatedMinutes Int?
  thankYouMessage  String?

  // Lead-capture configuration: enable + require each field independently.
  collectFirstName   Boolean  @default(true)
  firstNameRequired  Boolean  @default(true) // name mandatory by default; unset per assessment if not needed
  collectLastName    Boolean  @default(true)
  lastNameRequired   Boolean  @default(false)
  collectEmail       Boolean  @default(true)
  emailRequired      Boolean  @default(true)
  collectMobile      Boolean  @default(true)
  mobileRequired     Boolean  @default(true) // phone mandatory by default; unset per assessment if not needed
  collectProfession  Boolean  @default(true)
  professionRequired Boolean  @default(true)
  // Custom profession dropdown options. Empty = the built-in default list.
  professionOptions  String[] @default([])

  // Editable lead-field LABELS on the opt-in form. Null = the built-in default
  // ("First name", "Email", "Profession", …). Only the label changes, not the field.
  firstNameLabel        String?
  lastNameLabel         String?
  emailLabel            String?
  mobileLabel           String?
  professionLabel       String?
  // Placeholder shown in the profession dropdown (null = "Select your profession").
  professionPlaceholder String?

  // Lead-capture position: false = the opt-in form is the FIRST screen (default);
  // true = show a landing (headline + Start) first, ask the questions, THEN collect
  // the lead on an opt-in form before results.
  leadCaptureAfter Boolean @default(false)

  // Whether the lead fields are asked all on one screen (every funnel built so far)
  // or in stages across the run. Defaults to ALL_AT_ONCE, so nothing already live
  // changes, and leadCaptureAfter keeps deciding the position in that mode.
  //
  // 🔴 SPLIT reads the SAME lead columns as ALL_AT_ONCE - collect*, *Required,
  // *Label, optinFields, every one of them. It changes WHERE a field is asked, never
  // what was configured, so switching modes loses nothing and an imported assessment
  // populates both. The only thing SPLIT overrides is requiredness: in that mode
  // every collected field is mandatory (see the builder, which hides those toggles).
  leadCaptureMode LeadCaptureMode @default(ALL_AT_ONCE)

  // Extra custom fields on the OPT-IN form (beyond the built-in lead fields), same
  // shape as preResultFields: [{ id, label, type: "text"|"select", options[], required }].
  // Null/empty = none. Answers land on Submission.optinAnswers.
  optinFields Json?

  // Editable intro copy. introNotice overrides the auto retake message on the
  // opt-in screen (null = the computed message). startButtonLabel overrides the
  // opt-in button text (null/empty = "Start").
  introNotice        String?
  startButtonLabel   String?
  // Lead-capture-AFTER only: the opt-in button shown AFTER the questions. Distinct
  // from startButtonLabel (the landing's Start). null/empty = "Show my results".
  resultsButtonLabel String?

  // Retake lockout: how often a respondent (keyed by uniqueIdentifier) may
  // retake. DELAYED uses retakeDays; NEVER = once; UNLIMITED = no throttle.
  retakePolicy     RetakePolicy     @default(DELAYED)
  retakeDays       Int              @default(15)
  uniqueIdentifier UniqueIdentifier @default(EMAIL)
  // Optional VSL/training link shown on the retake-lockout screen.
  trainingUrl      String?

  // Scoring/result engine. GENERIC (default) keeps the built-in category-weight
  // scorer. CLINIC_AUDIT routes scoring + result rendering to the data-driven
  // patient-acquisition funnel engine (see lib/scoring/clinic-audit.ts).
  engine       AssessmentEngine @default(GENERIC)
  // Optional model-parameter overrides for CLINIC_AUDIT (costPerEnquiry, bookRateCap,
  // show-up target, override cutoffs, band gap thresholds, dormant %). Null => the
  // code defaults in lib/scoring/clinic-audit.ts (DEFAULT_ENGINE_CONFIG).
  engineConfig Json?

  // How questions are paginated for the respondent (one page / per category / one
  // question at a time).
  questionDisplayMode QuestionDisplayMode @default(ALL)

  /// Paginated modes auto-advance when a screen is fully answered, except the LAST
  /// screen, where a Submit button stays a deliberate tap. That exception is why a
  /// respondent can answer every question and still never see the opt-in form - they
  /// are finished, and one unpressed button away from being a lead.
  ///
  /// On: answering the last question goes straight on, with no button. Off by default,
  /// because a deliberate Submit is also the last chance to change an answer, and on a
  /// screen holding several questions that chance is worth keeping.
  autoAdvanceLastScreen Boolean @default(false)

  /// Whether the result TOKEN link renders the result page, whatever the funnel's next
  /// step is.
  ///
  /// These were tangled: a result could only be seen in-platform when nextStep was
  /// RESULTS, which conflated "where the funnel sends people automatically" with "what a
  /// link I email later will show". A funnel that ends at a signup page could therefore
  /// never show a respondent their own result, even though it had been scored and stored.
  ///
  /// Off by default. The token is already in the respondent's destination URL, so turning
  /// this on for a funnel that deliberately withholds results would start handing them out.
  resultLinkShowsResult Boolean  @default(false)
  // Explicit "next step" after the Results page. Source of truth for the flow;
  // paidMode below is kept in sync (PAYMENT => paidMode true) so existing payment,
  // event, and runner logic keeps working unchanged.
  nextStep              NextStep @default(DESTINATION)

  // Destination page the respondent lands on after completing (with ?t=<token>).
  // Its ORIGIN (derived on save) is what authorizes the public read endpoint's
  // CORS - the admin never configures CORS directly.
  targetUrl       String?
  targetOrigin    String? // scheme://host[:port], derived from targetUrl
  tokenTtlSeconds Int? // result-token TTL; null => system default

  // "Show results on assess360" (nextStep RESULTS) only: an OPTIONAL onward link
  // rendered as a plain button at the bottom of the result page (both the generic
  // band result and the clinic recalc). No token is appended - it points at a plain
  // external landing page. Null/blank => no button (unchanged result page).
  resultsContinueUrl   String?
  resultsContinueLabel String? // button text; null/blank => "Continue"
  // Anticipation countdown (seconds) shown after Submit before the destination/VSL
  // loads. 0 = redirect immediately. Default 10.
  vslCountdownSeconds  Int     @default(10)

  // Per-assessment reporting floor ("Data window"). When set, this assessment's own
  // Stats/Submissions/Contacts count only records at/after this instant. Independent
  // of the platform-wide AppSetting.statsResetAt used by the global pages.
  statsResetAt DateTime?

  // Which AI result-instructions version drives THIS assessment's statement. Null =>
  // the tenant default (AppSetting.aiPromptVersion). A built-in code id or AiPromptVersion id.
  aiPromptVersionId String?
  // When false, no AI personal statement is generated/shown - the results (scores,
  // bands, category meanings, template) convey the message on their own.
  useAiStatement    Boolean @default(true)

  // Pay-to-unlock. When paidMode is on, submitting the assessment stores results
  // then redirects to paymentUrl (with ?t=<token>) INSTEAD of the destination/VSL;
  // the submit screen shows paymentHeadline + the paymentButtonLabel nudge. Off =>
  // normal destination redirect. After paying, the provider sends the user to the
  // destination/VSL (carrying the token) where results + the calendar button show.
  paidMode           Boolean @default(false)
  paymentUrl         String?
  // EXTERNAL gateway mode only (a payment link, no Razorpay keys). The query
  // parameter that gateway appends to its success URL carrying its own reference,
  // e.g. "session_id" or "razorpay_payment_id". Blank = the gateway appends nothing,
  // which is the common case; the return is then resolved by the handoff cookie or
  // the email fallback. See api/pay/return/[tenant].
  paymentReturnParam String?
  paymentHeadline    String?
  paymentButtonLabel String?
  paymentAmount      Int? // price in INR rupees (e.g. 199); ×100 = paise for Razorpay
  // Meta event name fired on a verified paid unlock (server CAPI + browser pixel,
  // deduped by the Razorpay payment id). Custom + price-independent so it survives
  // price changes (₹199→₹299…). Default "Purchase121".
  paymentEventName   String  @default("Purchase121")
  // Payment notice shown on the opt-in/lead form, above the Start button (paid
  // mode only) - sets the expectation up front so there are no surprises.
  paymentIntroText   String?

  // ---- Audience gate + cascade routing (Phase 2) ----
  // A first-screen role DROPDOWN. Each role (and an optional "None of the above")
  // routes PER-CHOICE - either continue in THIS assessment (lead form + questions)
  // or redirect to another assessment, which shows its own gate (cascade). Stored as
  // JSON so the shape can evolve without a migration. Shape:
  //   { label?, placeholder?, roles: [{ id, label, target }],
  //     noneEnabled?, noneLabel?, noneTarget? }
  // target / noneTarget: "" (or absent) = continue in THIS assessment; otherwise an
  // assessment id to redirect to. Null / no roles = no gate (the normal opt-in flow).
  audienceGate Json?
  // Meta CAPI + browser pixel fire ONLY when true. The ad-entry (level-1) assessment
  // is true; routed (level 2+) assessments are false, so onward routing never pollutes
  // Meta's learning. Default true keeps every existing assessment firing as before.
  fireMetaCapi Boolean @default(true)

  // Which Meta events THIS assessment reports, when fireMetaCapi is on.
  // { registration?: false, completion?: false, gateDisqualified?: false, abandoned?: false }
  // Only an explicit false turns one off; null/absent = all on, so an assessment saved
  // before this existed keeps reporting exactly what it did. These events feed live ad
  // audiences, so a default of "off" would have quietly stopped populating audiences on
  // funnels that are currently spending. Purchase is NOT here - it fires from the
  // Razorpay webhook, which has no assessment in scope. See features/assessment/meta-events.
  metaEvents Json?

  // ---- Qualification gate (Page 1) + disqualified page ----
  // Page-1 gating questions shown one-at-a-time BEFORE the assessment. Each option
  // qualifies or disqualifies. Shape: { enabled, questions: [{ id, text, options:
  // [{ id, label, disqualifies }] }] }. A disqualifying answer routes to the
  // disqualified page and creates NO lead / submission / result / Lead-CAPI - only
  // an optional custom "Disqualified" Meta pixel event (for ad exclusion). Null = no gate.
  qualification       Json?
  // ONE sentence shown directly above the opt-in form.
  //
  // After a qualification gate this is the first thing a qualified person reads, and
  // the only thing standing between answering several questions and being handed a bare
  // form. Deliberately a single free-text line rather than a structured block: this copy
  // is an offer, offers change weekly, and anything with more fields than that becomes a
  // thing to maintain instead of a thing to rewrite. Null/blank = nothing rendered.
  qualifiedNote       String?
  // Content shown to a disqualified visitor (heading/subtext/body/button + the
  // fire-"Disqualified"-event toggle). Nothing about the visitor is stored.
  disqualifiedContent Json?

  // Published snapshot of the result-page builder (array of AssessmentPageData).
  // The relational AssessmentPage/PageBlock rows are the editable DRAFT; the public
  // renders ONLY this snapshot, so unpublished edits never go live. Null = no pages
  // published yet (old flow: straight to payment/VSL).
  publishedPages   Json?
  pagesPublishedAt DateTime?

  // VSL result page (RESULTS mode): a self-contained marketing page - eyebrow,
  // headline, the respondent's AI statement, a VSL video embed, styled buttons and
  // YouTube testimonials - shown at /a/:slug/r/:id?t=… . resultPage is the editable
  // DRAFT (theme + ordered blocks JSON); resultPagePublished is the live snapshot the
  // token page renders. Null published = fall back to the default score cards.
  resultPage            Json?
  resultPagePublished   Json?
  resultPagePublishedAt DateTime?

  // The two result pages this assessment uses, each a ResultPageDoc bound 1:1. The
  // UNIQUE on each id is the whole rule: a doc can be used by at most one assessment,
  // enforced by the database rather than by whichever action happens to check. Need the
  // same page on a second funnel? Clone it - that is a different doc with its own slug.
  //
  // SetNull on delete: deleting an assessment frees its pages back into the library
  // rather than destroying work that is still worth cloning.
  resultsDocId String?        @unique
  resultsDoc   ResultPageDoc? @relation("AssessmentResultsDoc", fields: [resultsDocId], references: [id], onDelete: SetNull)
  vslDocId     String?        @unique
  vslDoc       ResultPageDoc? @relation("AssessmentVslDoc", fields: [vslDocId], references: [id], onDelete: SetNull)

  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Multi-tenancy retained; null = platform-owned (MVP default).
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  categories            Category[]
  resultBands           ResultBand[]
  submissions           Submission[]
  pageViews             PageView[]
  gateDisqualifications GateDisqualification[]
  ctaClicks             CtaClick[]
  gateEntries           GateEntry[]
  eventCounts           FunnelEventCount[]
  bookingTypes          BookingType[]

  @@index([tenantId])
  @@index([status])
  @@map("assessment")
}

// ---------------------------------------------------------------------------
// ResultPageDoc - a result page as a record of its own.
//
// WHY A SEPARATE TABLE
// Both result pages used to live on the assessment: the post-questions page as
// AssessmentPage rows plus a published snapshot, the VSL page as two JSON columns.
// That made every page a child of one funnel, so building the next funnel meant
// rebuilding the same eyebrow, headline, video and footer by hand.
//
// A doc is the same content with its own name, slug, editor and Publish button. You
// clone one, change the video link, bind it to a funnel, publish. The binding is
// strictly 1:1 (see the UNIQUE columns on Assessment): no two funnels ever share a
// page, so editing one can never reword a page somebody else's ad traffic is landing
// on, and a per-funnel value (a booking inbox, a calendar link, an exit-route block)
// is always correct for the one funnel it serves.
//
// WHAT IS LIVE
// Publishing a doc writes this row's snapshot AND mirrors it onto the bound
// assessment's own column, which is what the public still renders. The live read path
// is therefore unchanged by this table existing, and a doc that is bound to nothing
// is simply a draft in the library.
//
// Each kind keeps the storage it already had: VSL in `draft` (theme + blocks),
// RESULTS in AssessmentPage rows pointing here. Asymmetric on purpose - it is what
// made this a re-parent instead of a rewrite of two working builders.
// ---------------------------------------------------------------------------

enum ResultPageKind {
  RESULTS // the page shown after the questions (bands, category teaser, pay button)
  VSL // the marketing page on the token link (headline, video, booking CTA)
}

model ResultPageDoc {
  id    String         @id @default(cuid())
  kind  ResultPageKind
  title String
  /// Library identifier, unique within the workspace. Not a public URL - a respondent
  /// always arrives at /a/<assessment-slug>/r/<id>?t=... - so there is no reason to
  /// make one workspace's naming collide with another's.
  slug  String

  /// VSL only: the editable draft (theme + ordered blocks). RESULTS keeps its draft in
  /// the AssessmentPage rows below.
  draft Json?

  /// The published snapshot, in the shape that kind already published: ResultPageData
  /// for VSL, AssessmentPageData[] for RESULTS. Mirrored onto the bound assessment.
  published   Json?
  publishedAt DateTime?

  /// The doc this one was cloned from, for provenance only. Never a live link.
  sourceSlug String?

  /// ---- The platform shelf ----------------------------------------------------
  /// On the shelf = every workspace sees this page and can import a copy of it. Only
  /// a PLATFORM-owned page can be listed (the actions enforce it), and only one that
  /// is bound to no funnel: a template is a starting point, not somebody's live page.
  ///
  /// Deliberately NOT the same field as `published`, which means "has a live
  /// snapshot". A page can be on the shelf and never published, which is the normal
  /// case - what tenants import is the draft.
  shelfListed   Boolean @default(false)
  /// Heading the shelf groups it under, e.g. "Coaches", "Clinics". A plain string,
  /// not an enum: a new audience must not need a migration.
  shelfCategory String?
  /// One or two lines: what this page is for. Shown on the shelf row.
  shelfSummary  String?
  shelfOrder    Int     @default(0)

  /// Owning workspace. Null = the platform's own library (super admin, no workspace
  /// entered). SetNull rather than Cascade: a deleted tenant's assessments survive as
  /// platform-owned, so their pages must survive with them.
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  /// RESULTS only: the editable draft.
  pages AssessmentPage[]

  /// The 1:1 binding, seen from this side. Both null = a free page in the library.
  resultsOf Assessment? @relation("AssessmentResultsDoc")
  vslOf     Assessment? @relation("AssessmentVslDoc")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, slug])
  @@index([tenantId, kind])
  @@index([shelfListed, kind, shelfOrder])
  @@map("result_page_doc")
}

// ---------------------------------------------------------------------------
// AssessmentPage / PageBlock - the post-assessment page builder. Pages render in
// order after the questions; each holds ordered, typed blocks whose `config` is
// type-specific JSON (so new block types never change the schema). See
// features/assessment/pages/blocks.ts for the block vocabulary.
// ---------------------------------------------------------------------------

model AssessmentPage {
  id        String   @id @default(cuid())
  /// The result page this draft page belongs to. A page is owned by a DOC, not by an
  /// assessment: the same content can be cloned into a new doc and bound elsewhere,
  /// and a doc that is bound to nothing is still editable.
  docId     String
  order     Int      @default(0)
  title     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  doc    ResultPageDoc @relation(fields: [docId], references: [id], onDelete: Cascade)
  blocks PageBlock[]

  @@index([docId, order])
  @@map("assessment_page")
}

model PageBlock {
  id        String   @id @default(cuid())
  pageId    String
  order     Int      @default(0)
  type      String // see BlockType in features/assessment/pages/blocks.ts
  config    Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  page AssessmentPage @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([pageId, order])
  @@map("page_block")
}

// ---------------------------------------------------------------------------
// PageView - one row per opt-in (public assessment) page load, for analytics.
// visitorId comes from a long-lived cookie so "unique" = distinct visitors.
// ---------------------------------------------------------------------------

model PageView {
  id           String     @id @default(cuid())
  assessmentId String
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  visitorId    String
  createdAt    DateTime   @default(now())

  // Marketing attribution captured at page-view time (before any lead exists),
  // so traffic-source counts populate even with zero opt-ins.
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  utmTerm     String?
  utmContent  String?
  fbclid      String?
  gclid       String?

  // Automated-client flag: the visit's User-Agent matched a bot/crawler/renderer
  // (e.g. Meta's ad-review agent, which hits the bare URL with no UTM). Recorded
  // for audit but excluded from every human-facing metric. userAgent kept so a
  // misclassification is inspectable.
  isBot      Boolean @default(false)
  userAgent  String?
  // Client IP (x-forwarded-for first hop). Captured for the log + bot triage; not
  // shown publicly. Admin-only visibility.
  ip         String?
  // Geo (Cloudflare headers) + device (parsed UA). Enrichment for the log/export;
  // all null when the CF location-headers transform is off / UA is unknown.
  country    String?
  city       String?
  region     String?
  postalCode String?
  timezone   String?
  deviceType String?
  browser    String?
  os         String?

  // Owning tenant (denormalized from the assessment; null = platform/Gita). Scalar
  // only - no FK - since page views are high-write and already cascade via assessment.
  tenantId String?

  @@index([assessmentId])
  @@index([visitorId])
  @@index([createdAt])
  @@index([utmSource])
  @@index([utmCampaign])
  @@index([tenantId, createdAt])
  @@map("page_view")
}

// ---------------------------------------------------------------------------
// Category - groups questions; ordered for display.
// ---------------------------------------------------------------------------

model Category {
  id           String   @id @default(cuid())
  name         String
  description  String?
  displayOrder Int      @default(0)
  // Which page of the funnel this category belongs to: 1 = the main assessment,
  // 2 = the separate "queries" page (its own scored questions, shown after the
  // assessment; scored + banded independently; results show both pages).
  page         Int      @default(1)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  assessmentId String
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  questions      Question[]
  categoryScores SubmissionCategoryScore[]
  bands          CategoryResultBand[]

  @@index([assessmentId])
  @@map("category")
}

// ---------------------------------------------------------------------------
// Question - single-select for MVP; carries a weight for scoring.
// ---------------------------------------------------------------------------

model Question {
  id                      String       @id @default(cuid())
  text                    String
  type                    QuestionType @default(SINGLE_SELECT)
  weight                  Float        @default(1)
  required                Boolean      @default(true)
  displayOrder            Int          @default(0)
  // CLINIC_AUDIT engine only: the funnel role this question feeds - one of
  // ENQUIRIES, BOOK_RATE, SHOWUP_RATE, CLOSE_RATE, TREATMENT_VALUE, AD_SPEND,
  // DORMANT, CAPACITY, UPLIFT_BOOKRATE. Null = not a scoring input (context /
  // qualifier). Ignored by the GENERIC engine. See lib/scoring/clinic-audit.ts.
  scoringRole             String?
  // CLINIC_AUDIT: the UNIT this question's numbers are expressed in - PER_10
  // ("out of every 10"), PER_100 (percent / "out of every 100"), RUPEES, COUNT,
  // or POINTS (book-rate uplift). Applies to BOTH the option values and the
  // respondent's typed actual number, so a question worded "out of every 10"
  // can never be silently read as a percentage. Null = the role's default
  // (rates → PER_100), which preserves every existing configuration exactly.
  scoringUnit             String?
  // ---- Default (unconditional) route ----------------------------------------
  // Where the flow goes from this question when NO option rule applies: the question
  // was skipped (optional), it is FREE_TEXT so there is no option at all, or the chosen
  // option simply carries no rule. Null = continue linearly, which is every existing
  // question.
  //
  // This is what lets a branch CONVERGE. Option rules alone can fan a survey out into
  // per-answer branches but cannot bring them back: a branch whose last question is
  // optional or typed would fall straight into the NEXT branch's questions. The default
  // route is the "and then rejoin here" half of branching.
  //
  // Same forward-only guarantee as QuestionRoute, validated on save, and the engine
  // degrades a missing target to a linear step, so a deleted target can never loop.
  defaultRouteAction      RouteAction?
  defaultTargetQuestionId String? // scalar ref (no FK), validated forward-only on save
  defaultTargetCategoryId String? // scalar ref (no FK), validated forward-only on save
  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @updatedAt

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  options Option[]
  answers SubmissionAnswer[]
  // Conditional routing: rules that fire when one of THIS question's options is
  // chosen (the option is the trigger). See QuestionRoute + lib/routing/engine.ts.
  routes  QuestionRoute[]    @relation("QuestionRoutes")

  @@index([categoryId])
  @@map("question")
}

// ---------------------------------------------------------------------------
// QuestionRoute - conditional-routing rule (Phase 1). One per ANSWER OPTION
// (optionId @unique): when the respondent picks that option, the flow does the
// route's action - continue linearly (NEXT), jump forward to a specific question
// or category, or end the questions (SKIP_TO_END). Targets are forward-only
// (validated on save) and additive: an assessment with no routes behaves exactly
// as before. targetQuestionId/targetCategoryId are plain scalar refs (no FK), so
// deleting a target never cascades here; the engine treats a missing target as a
// linear NEXT. Only honored in the SINGLE (one-question-per-page) display mode.
// ---------------------------------------------------------------------------

enum RouteAction {
  NEXT // continue to the next question in order (same as no route)
  JUMP_TO_QUESTION // jump forward to targetQuestionId
  JUMP_TO_CATEGORY // jump forward to the first question of targetCategoryId
  SKIP_TO_END // end the questions and go to submit/results
}

model QuestionRoute {
  id               String      @id @default(cuid())
  action           RouteAction @default(NEXT)
  targetQuestionId String? // scalar ref (no FK); validated forward-only on save
  targetCategoryId String? // scalar ref (no FK); validated forward-only on save
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  questionId String
  question   Question @relation("QuestionRoutes", fields: [questionId], references: [id], onDelete: Cascade)

  // The trigger option. Unique = at most one route per option (single-select).
  optionId String @unique
  option   Option @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@index([questionId])
  @@map("question_route")
}

// ---------------------------------------------------------------------------
// Option - selectable answer with a numeric score value (e.g. 1..4).
// ---------------------------------------------------------------------------

model Option {
  id              String   @id @default(cuid())
  label           String
  // GENERIC engine: the score point (1..4). CLINIC_AUDIT engine: the working figure
  // for the question's scoringRole - rupees/counts as-is (90000, 90), rates & uplift
  // as whole-number percent (32 = 0.32 book rate, 6 = +0.06 uplift). Int-only.
  value           Int
  // CLINIC_AUDIT: fixed "weakest area" diagnosis line shown when this answer is one
  // of the two weakest (assembled, never AI-generated). Null = no clause.
  diagnosisClause String?
  // CLINIC_AUDIT: marks an "I don't know / not sure" option, so the engine uses this
  // value as a fallback assumption and surfaces it on the result page for correction.
  isAssumption    Boolean  @default(false)
  displayOrder    Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  answers SubmissionAnswer[]
  // Conditional routing: the rule that fires when THIS option is chosen (if any).
  route   QuestionRoute?

  @@index([questionId])
  @@map("option")
}

// ---------------------------------------------------------------------------
// ResultBand - score range -> interpretation shown after submission.
// ---------------------------------------------------------------------------

model ResultBand {
  id           String    @id @default(cuid())
  level        BandLevel
  title        String
  description  String?
  minScore     Float
  maxScore     Float
  displayOrder Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  assessmentId String
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  submissions Submission[]

  @@index([assessmentId])
  @@map("result_band")
}

// ---------------------------------------------------------------------------
// CategoryResultBand - per-CATEGORY band: a percentage range -> {label, meaning}.
// Mirrors ResultBand but scoped to a Category. minScore/maxScore are 0-100
// percentages (same basis as overall bands). Non-overlap validated like overall.
// ---------------------------------------------------------------------------

model CategoryResultBand {
  id           String   @id @default(cuid())
  label        String
  meaning      String?
  minScore     Float // percentage 0-100
  maxScore     Float
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([categoryId])
  @@map("category_result_band")
}

// ---------------------------------------------------------------------------
// Submission - one run of an assessment. Lead snapshot stored inline.
// ---------------------------------------------------------------------------

model Submission {
  id     String           @id @default(cuid())
  status SubmissionStatus @default(STARTED)

  // First time this respondent clicked a result-page booking CTA. Denormalized from
  // CtaClick so the Submissions table can show and sort a "Booking requested" column
  // without a join. Null = never asked for a call.
  ctaClickedAt DateTime?

  /// The PERSON behind this run. Nullable, and deliberately not the source of truth:
  /// the lead columns below stay the snapshot of what was typed that day, and this is
  /// only how the run is attributed to a contact. Backfilled; null on rows that have
  /// no email and no mobile to match on.
  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  leadFirstName  String?
  leadLastName   String?
  leadEmail      String?
  leadMobile     String?
  leadProfession String?
  // Audience gate (Phase 2): the role the respondent picked on the gate screen, if
  // this assessment has one. Kept separate from leadProfession (which is mapped to
  // the CRM verbatim) so the gate never disturbs that mapping. Null = no gate / skipped.
  audienceRole   String?

  // Answers to the assessment's optional "pre-results" data-capture page, keyed by
  // the field id: { [fieldId]: string }. Null when the assessment has no such page.
  preResultAnswers Json?

  // Answers to the assessment's extra OPT-IN fields, keyed by field id. Null = none.
  optinAnswers Json?

  // CLINIC_AUDIT only: the respondent's ACTUAL number for a scored question, keyed
  // by questionId: { [questionId]: string }, when they knew it and typed it instead
  // of relying on their selected range's midpoint. Null/absent per-question = use
  // the option's stored value (and the result page/PDF tag that figure "assumed").
  clinicActualAnswers Json?

  // Marketing attribution captured from the landing URL (utm_*, fbclid, gclid).
  // Stored as JSON so new click-id params need no schema change.
  attribution Json?

  // Meta CAPI match signals, captured server-side at Start (from the request:
  // ip, UA, and the _fbp/_fbc pixel cookies) and backfilled at Complete if a
  // cookie was set late. Exposed via /api/meta-match for an external CAPI sender
  // (n8n). fbclidTimestamp = unix seconds when the fbclid was first recorded, so
  // fbc can be rebuilt as fb.1.<ts>.<fbclid> when the _fbc cookie is absent.
  clientIp             String?
  userAgent            String?
  fbp                  String?
  fbc                  String?
  // First-party id (per-visitor UUID from the browser's localStorage), captured at
  // Start. Sent as external_id in Meta CAPI user_data (a standalone match key, no PII)
  // and matches the browser pixel's advanced-matching external_id.
  metaExternalId       String?
  // Answers to the qualification gate's TEXT questions (keyed by question id). For
  // MANUAL review only (never qualifies) - surfaced in the Submissions "Custom details".
  qualificationAnswers Json?

  // Points earned at the QUALIFICATION GATE, and the most that gate could have awarded.
  // Stored at start rather than recomputed at completion, because the gate config can be
  // edited between the two and a score that silently changes under a respondent is worse
  // than one that is slightly stale. Null on every submission created before gate scoring
  // existed, and on any funnel whose gate awards nothing, which is why the scorer treats
  // absent as zero rather than as an error.
  gateScore Int?
  gateMax   Int?

  // Which score band the gate put them in: PASS (clear) or REVIEW (through, but worth
  // the owner's eyes before a call). Null = the funnel has no bands, which is every
  // gate that existed before them. Never shown to the respondent - the gate score is
  // the owner's instrument, and a number on the screen is a number to play to.
  gateBand String?

  // Set when this submission came in through an OPTIN exit route rather than the
  // funnel proper - the waitlist case: someone the gate sent sideways, whose details
  // are worth having anyway. Holds the exit's key.
  //
  // It is what keeps the two apart everywhere afterwards: these people never answer the
  // assessment, so without it the abandoned sweep would chase them and every completion
  // rate would read as though they had dropped out.
  gateExitKey String?

  /// The gate, question by question, resolved AT THE MOMENT IT WAS ANSWERED: question
  /// text, the option picked, what it scored and what it could have scored.
  /// Shape: [{ q, a, points, max }].
  ///
  /// Stored rather than rebuilt at render, for the same reason gateScore is written at
  /// start: the gate is a JSON blob the owner can edit at any time, and a result page
  /// that silently rewords its own questions - or drops one that was deleted - is worse
  /// than one that is slightly stale. Results already given out must not move.
  ///
  /// Null for submissions taken before this existed, and for funnels with no gate.
  gateBreakdown   Json?
  // Geo (Cloudflare) + device (parsed UA), captured at Start. region/postalCode feed
  // Meta CAPI advanced matching (st/zp); country is the 2-letter ISO code.
  country         String?
  city            String?
  region          String?
  postalCode      String?
  timezone        String?
  deviceType      String?
  browser         String?
  os              String?
  // Unix MILLISECONDS (matches Meta's fbc format fb.1.<ms>.<fbclid> exactly, so no
  // unit conversion anywhere). Double, because a ms epoch overflows Int4 - the value
  // is always an integer and is exact in a double well beyond any realistic date.
  fbclidTimestamp Float?

  // Normalized retake/dedup key (lowercased email or digits-only mobile),
  // captured at start per the assessment's uniqueIdentifier. Indexed for the
  // lockout lookup + future progress-trend queries.
  identifierValue String?

  // Opaque public ids (no-ambiguous alphabet). customerId minted at lead capture
  // (separate from identifierValue); resultToken minted on completion and placed
  // in the destination URL. resultSnapshot is the denormalized read-endpoint
  // payload, computed once at completion for a fast, join-free GET /api/r/:token.
  customerId           String?   @unique
  // Object key of this submission's rendered PDF report in R2, once one exists.
  //
  // NEVER sent to a client. The key is the only thing that reveals where a file sits,
  // so it stays server-side: the report is served by streaming it through
  // /api/reports/<id> after authorisation, not by handing out a bucket URL. The file
  // name is random rather than derived from the submission id, so knowing one key tells
  // you nothing about any other and the bucket cannot be walked.
  //
  // Null = not rendered yet (or cleared because the result changed, which makes the
  // stored copy stale). Rendering fills it; the next request serves the stored file.
  reportKey            String?
  // The PREVIOUS rendered report, kept so a regeneration can be rolled back.
  //
  // Exactly two slots rather than a list: "keep the latest two" IS two slots, and a
  // JSON array would need pruning logic that can drift from the retention rule it is
  // meant to enforce. Superseding rotates current → previous and deletes whatever was
  // in previous, so at most two objects exist per submission and storage cannot creep.
  reportPrevKey        String?
  resultToken          String?   @unique
  // Unguessable capability returned to the client at Start; required to save drafts
  // or complete, so those write actions can't be driven by guessing the submission id.
  editToken            String?
  resultTokenExpiresAt DateTime?
  resultSnapshot       Json?

  // AI-generated personalized statement (stored against this submission/date).
  aiStatement String?
  // Admin-authored "Add to PDF" note - the post-call action items / meeting summary
  // appended at the bottom of the PDF report. Not shown to the respondent elsewhere.
  reportNote  String? @db.Text

  totalScore Float?
  maxScore   Float?

  // CRM "score_updated" resend queue. crmDirty = data changed in-app (band
  // recompute / AI re-run) and not yet pushed; the drip sends dirty rows one at a
  // time and clears the flag. crmAttempts caps retries; crmSentAt/crmLastError
  // record the last outcome.
  crmDirty     Boolean   @default(false)
  crmSentAt    DateTime?
  crmAttempts  Int       @default(0)
  crmLastError String?
  // Set when a contact is FROZEN into the current resend batch (at Start). The
  // drip sends only queued rows, so a batch sends exactly the set pending when it
  // started - never contacts dirtied later. Cleared on successful send.
  crmQueuedAt  DateTime?

  startedAt          DateTime  @default(now())
  completedAt        DateTime?
  abandonedAt        DateTime? // set by the abandonment sweep when STARTED past the delay
  // Manual Meta review (Submissions table buttons). The owner reads the lead and
  // fires QualifiedCompletion or GateDisqualified by hand - for the gate's TEXT
  // answers, which never auto-qualify. Stamps exist so a reviewed row is visibly
  // different from an untouched one; re-clicking is allowed and re-stamps.
  metaQualifiedAt    DateTime?
  /// Set when StartTrial was reported for this lead by hand. The owner clicks it when
  /// someone actually starts using the trial, which is a judgement no funnel event can
  /// make. Stamped only on a successful send, and checked before sending, so a second
  /// click reports nothing and the trial audience cannot be inflated by clicking twice.
  metaStartTrialAt   DateTime?
  metaDisqualifiedAt DateTime?
  // Paid-mode pipeline guards (compare-and-swap so each event fires once):
  completedPaidAt    DateTime? // set when completed_paid fired (payment verified)
  completedUnpaidAt  DateTime? // set when completed_unpaid fired (sweep, 30 min unpaid)
  // Autosaved in-progress answers (questionId -> optionId) so a returning unpaid
  // respondent resumes + edits where they left off, until they pay.
  draftAnswers       Json?
  /// This run was an owner PREVIEWING their own funnel (?preview=1).
  ///
  /// Everything about a preview is real except the server-side Meta conversion: the
  /// row, the browser pixel, the webhook. The owner is testing whether those work.
  /// Stored rather than passed around because events fire LATER too - the abandon
  /// sweep and the CRM drip run hours afterwards, long after the flag has gone, and
  /// without this they would report the owner's own walkthrough to a live ad account.
  isPreview          Boolean   @default(false)
  /// How much of the result page's VSL this person has watched, per VidaPulse session:
  /// { [sessionId]: { pct, secs, at } }. Null = nothing reported.
  ///
  /// 🔴 Per SESSION on purpose. VidaPulse counts per session (a new one starts at zero
  /// on every page load), so a single stored number would FALL when somebody reopens
  /// the emailed link and leaves after twenty seconds. Kept apart and folded in
  /// features/assessment/watch/merge.ts, where furthest-reached is the max across
  /// sessions and can only rise, and watch time is the sum and cannot double-count.
  vslWatchSessions   Json?
  /// Derived from vslWatchSessions on every write, so the Submissions table can sort
  /// and filter without unpacking the JSON. Never written independently of the map.
  vslMaxPct          Float?
  vslWatchSeconds    Float?
  /// The video's full length in seconds, as last reported. Lets "5:09 of 15:10" be
  /// shown without asking VidaPulse anything.
  vslDuration        Float?
  resultViewedAt     DateTime? // set once when the internal result page is first viewed
  resultFetchedAt    DateTime? // set on first /api/r read = the VSL page pulled the result
  resultFetchCount   Int       @default(0) // total /api/r reads = how many times the VSL loaded
  // Nurture (one-shot Email + WhatsApp on opt-in): stamped when nurture is FIRST
  // attempted for this submission, so a re-submit/edit never re-sends. Null = not run.
  nurtureSentAt      DateTime?
  // Billing gate: the 1-based index of this completion WITHIN its tenant's billing
  // period (stamped once, at the winning STARTED->COMPLETED flip, from the RESPONSES
  // usage counter). A response is "over cap / locked" when periodSeq > the tenant's
  // CURRENT responsesPerMonth limit - compared live, so raising the plan instantly
  // unlocks past leads with no backfill. null = completed before this gate shipped
  // (grandfathered visible) or an unmetered platform/Gita submission.
  periodSeq          Int?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  assessmentId String
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  // Snapshot tenant for later querying/segmentation.
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  resultBandId String?
  resultBand   ResultBand? @relation(fields: [resultBandId], references: [id], onDelete: SetNull)

  answers        SubmissionAnswer[]
  categoryScores SubmissionCategoryScore[]
  aiStatements   AiStatement[]
  crmSendJobs    CrmSendQueue[]
  nurtureLogs    NurtureLog[]
  ctaClicks      CtaClick[]
  appointments   Appointment[]

  @@index([assessmentId])
  @@index([leadEmail])
  @@index([createdAt])
  @@index([status, startedAt]) // abandonment sweep
  @@index([assessmentId, identifierValue, status]) // retake lockout + trend
  @@index([crmDirty]) // CRM resend drip queue
  @@index([gateExitKey]) // waitlist/opt-in exit rows, kept apart from the funnel proper
  @@map("submission")
}

// ---------------------------------------------------------------------------
// GateEntry - one row per visitor who PASSED the qualification gate (page 1).
//
// Why this exists: passing page 1 creates no Submission (that happens at the
// opt-in, which is the LAST step), so someone who qualifies and then leaves is
// invisible - exactly the person worth retargeting. This row is the only record
// they leave.
//
// It is deliberately NOT a Submission: it holds no lead, no answers, no score,
// and never appears in the Submissions table, counts, billing caps or stats. It
// exists solely to carry the Meta match signals (fbp/fbc/ip/ua/geo - captured
// server-side at pass time, because the browser is gone by the time we fire) so
// the abandonment sweep can send AssessmentAbandoned hours later.
//
// visitorId is the browser's first-party localStorage id (the same value that
// lands on Submission.metaExternalId), which is how the sweep tells "abandoned"
// from "went on to complete" without any lead data.
// ---------------------------------------------------------------------------
model GateEntry {
  id           String     @id @default(cuid())
  assessmentId String
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  /// Browser first-party visitor id → Submission.metaExternalId → CAPI external_id.
  visitorId String

  // Meta match signals, captured server-side when the gate was passed.
  clientIp    String?
  userAgent   String?
  fbp         String?
  fbc         String?
  country     String?
  city        String?
  region      String?
  postalCode  String?
  attribution Json?

  passedAt         DateTime  @default(now())
  /// Compare-and-swap guard: set when the abandon verdict was decided, so it fires once.
  abandonedFiredAt DateTime?

  /// When this visitor first REACHED the opt-in form. It is what separates the two
  /// ways of losing someone who passed the gate: set means they saw the form and left
  /// it (AssessmentAbandoned), null means they never got that far (GateIncomplete).
  /// Those are different audiences - one has seen the ask and refused it, the other
  /// never saw it - and an ad that treats them alike wastes money on one of them.
  optinSeenAt DateTime?

  /// When the abandon verdict becomes due. Set the moment the visitor leaves the
  /// opt-in page, ten minutes out, so someone who switches apps to fetch their
  /// WhatsApp number and comes back is never counted as lost. Null = no departure
  /// seen yet; the time-since-pass fallback still catches them.
  abandonDueAt DateTime?

  // Owning tenant (denormalized from the assessment; null = platform/Gita). Scalar
  // only - no FK - matching PageView / GateDisqualification. Added so "Qualified"
  // reads through the same tenant + date scope as every other funnel number.
  tenantId String?

  // -------------------------------------------------------------------------
  /// The person, when this gate captured one. Same rule as Submission: a link, not
  /// the source of truth.
  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  // SPLIT lead capture (leadCaptureMode = SPLIT). Everything below is null on a
  // row from an ALL_AT_ONCE funnel, which is every row that existed before this.
  //
  // WHY HERE AND NOT ON Submission. In split mode the contact details arrive before
  // the assessment is answered, so there is a real person with a real email and no
  // submission to hang them on for the next fifteen minutes. This row is already
  // "qualified, not a submission yet" - it has the visitor id, the Meta signals and
  // one row per visitor per assessment - so it is where they belong. A Submission is
  // created later, at the phone screen, which keeps the two menus meaning exactly
  // one thing each: Gate qualified = gave an email, Submissions = registered.
  // -------------------------------------------------------------------------

  /// The public customer id, minted when the gate starts and persisted when the email
  /// arrives. Carried onto the Submission unchanged, so one person has ONE cid across
  /// both menus and the two rows can always be told apart from two people.
  customerId String? @unique

  /// Unguessable capability returned when the lead row is written. The later screens
  /// must present it, so the phone screen cannot be driven by guessing a visitor id.
  leadToken String?

  leadFirstName  String?
  leadLastName   String?
  leadEmail      String?
  leadProfession String?
  /// The audience/role picked on the gate screen, mirrored the same way Submission
  /// does it so the two rows describe the person identically.
  audienceRole   String?

  /// 🔴 When an email was actually SUBMITTED - not when the screen was reached.
  ///
  /// This is what separates the two ways of losing someone who qualified, replacing
  /// optinSeenAt for split funnels: set means we have an address and can mail them
  /// (AssessmentAbandoned), null means we never got one (GateIncomplete). "Has an
  /// email" is actionable in a way that "looked at a form" is not.
  emailCapturedAt DateTime?

  /// Normalized dedup key (lowercased email / 10-digit mobile) per the assessment's
  /// uniqueIdentifier. Lets the retake lock run at the EMAIL screen, which in split
  /// mode is far earlier than it can run today, and lets a returning respondent
  /// re-attach to their own partial row instead of starting a second one.
  identifierValue String?

  /// The gate as answered, so the Gate qualified menu can show the owner WHY this
  /// person got through. Same shapes as the Submission columns of the same names, so
  /// nothing downstream has to learn a second format.
  gateScore            Int?
  gateMax              Int?
  gateBand             String?
  gateBreakdown        Json?
  qualificationAnswers Json?
  /// Custom opt-in field answers, which ride with the email screen.
  optinAnswers         Json?

  /// Written by an owner previewing their own funnel. The abandon sweep reads this
  /// before sending anything to Meta - see Submission.isPreview.
  isPreview Boolean @default(false)

  /// The Submission this lead became, once they reached the phone screen. Scalar, no
  /// FK, matching tenantId above. Null = still only a qualified lead.
  submissionId String? @unique

  // One row per visitor per assessment - a re-entry updates the existing row
  // rather than queueing a second abandonment event for the same person.
  @@unique([assessmentId, visitorId])
  @@index([abandonedFiredAt, passedAt]) // the sweep's scan
  @@index([abandonedFiredAt, abandonDueAt]) // the due-abandon scan
  @@index([assessmentId, passedAt]) // the Stats "Qualified" count
  @@index([tenantId, passedAt])
  @@index([assessmentId, emailCapturedAt]) // the Gate qualified menu
  @@index([tenantId, emailCapturedAt]) // the same, tenant-scoped
  @@index([assessmentId, identifierValue]) // retake lock + re-attach at the email screen
  @@map("gate_entry")
}

// ---------------------------------------------------------------------------
// FunnelEventCount - how many Meta events the funnel actually FIRED, as a running
// count rather than a row per firing.
//
// GateDisqualified is a browser-pixel-only event: nothing server-side ever saw it,
// so "is my exclusion audience being built?" was unanswerable from the app. Writing
// a row per firing would duplicate GateDisqualification (which counts PEOPLE) and
// grow without bound, so this is a counter: one row per assessment per event per
// IST day, incremented in place. Day buckets - not one lifetime total - so the
// Stats date range and the per-assessment Data window still apply.
//
// Counts EVENTS, not people: a renewal firing for a visitor already in the audience
// increments it again. That is the point - it is the number to compare with Meta.
// ---------------------------------------------------------------------------
model FunnelEventCount {
  id           String     @id @default(cuid())
  assessmentId String
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  /// Owning tenant (denormalized; null = platform/Gita), so the counter reads
  /// through the same tenant scope as the rest of the Stats page.
  tenantId String?

  /// The Meta event name exactly as fired - GateDisqualified, QualifiedCompletion,
  /// AssessmentCompleted. The ad account's audiences are keyed on these strings.
  eventName String

  /// IST midnight of the day the firings belong to (stored UTC), so a day bucket
  /// sits inside an IST-aligned Stats range.
  day DateTime

  /// Firings Meta ACCEPTED.
  count Int @default(0)

  /// Firings that failed (network error, or Meta rejected the payload). Kept beside
  /// the count so a silently broken audience is visible without a row per event.
  failed Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([assessmentId, eventName, day])
  @@index([tenantId, day])
  @@index([eventName, day])
  @@map("funnel_event_count")
}

// ---------------------------------------------------------------------------
// NurtureLog - one row per Email/WhatsApp send attempt fired on opt-in (or a
// manual resend/test). Best-effort delivery: failures are recorded here (no auto
// retry) so an operator can see and re-send. Scoped per tenant.
// ---------------------------------------------------------------------------
model NurtureLog {
  id           String      @id @default(cuid())
  tenantId     String?
  tenant       Tenant?     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  submissionId String?
  submission   Submission? @relation(fields: [submissionId], references: [id], onDelete: SetNull)
  channel      String // "EMAIL" | "WABA"
  status       String // "SENT" | "FAILED" | "SKIPPED"
  toAddress    String? // destination email or phone, for the log view
  error        String?
  // First time a tracked link in this email was clicked (EMAIL only). Set by the
  // /e/c/[id] click-redirect; null = not clicked (or not an email). Opens are not
  // tracked (deliberately - pixel opens are noisy); a click is the reliable signal.
  clickedAt    DateTime?
  createdAt    DateTime    @default(now())

  @@index([tenantId, createdAt])
  @@index([submissionId])
  @@map("nurture_log")
}

// ---------------------------------------------------------------------------
// AiStatement - versioned personalized messages for a submission. Many per
// submission; the one with isDefault=true is mirrored into resultSnapshot
// .aiStatement and is what the VSL serves. source: "ai" (model) | "manual"
// (admin-written). Nothing is auto-deleted.
// ---------------------------------------------------------------------------

model AiStatement {
  id            String     @id @default(cuid())
  submissionId  String
  submission    Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  text          String
  source        String     @default("ai") // "ai" | "manual"
  instruction   String? // admin steering (source=ai); null for manual / original
  promptVersion String? // base prompt version id (source=ai)
  isDefault     Boolean    @default(false)
  createdAt     DateTime   @default(now())

  @@index([submissionId])
  @@map("ai_statement")
}

// ---------------------------------------------------------------------------
// SubmissionAnswer - chosen option per question (one answer per question).
// ---------------------------------------------------------------------------

model SubmissionAnswer {
  id        String   @id @default(cuid())
  // The option's score point. 0 for a FREE_TEXT answer, which scores nothing.
  value     Int      @default(0)
  createdAt DateTime @default(now())

  submissionId String
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  // Null ONLY for a FREE_TEXT answer: there is no option to point at. Every
  // SINGLE_SELECT answer still carries one, so reads that expect an option must
  // treat null as "typed answer, read textValue" rather than as missing data.
  optionId String?
  option   Option? @relation(fields: [optionId], references: [id], onDelete: Cascade)

  // What they typed, for a FREE_TEXT question. Null on a chosen-option answer.
  textValue String? @db.Text

  @@unique([submissionId, questionId])
  @@index([submissionId])
  @@map("submission_answer")
}

// ---------------------------------------------------------------------------
// SubmissionCategoryScore - computed per-category score for a submission.
// ---------------------------------------------------------------------------

model SubmissionCategoryScore {
  id        String   @id @default(cuid())
  score     Float
  maxScore  Float
  createdAt DateTime @default(now())

  submissionId String
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([submissionId, categoryId])
  @@index([submissionId])
  @@map("submission_category_score")
}

// ===========================================================================
// Event Engine & Automation (Phase 1)
// ===========================================================================

// Assess360 is the source of truth ONLY for assessment-related events.
// External funnel events (e.g. external.vsl_viewed, external.strategy_call_booked)
// are owned by other systems and may be POSTed in later via a reserved ingest
// API - they are intentionally NOT part of this enum.
enum EventType {
  LEAD_CREATED // optin (merged opt-in; was lead.created + assessment.started)
  ASSESSMENT_STARTED // assessment.started (legacy; no longer emitted)
  ASSESSMENT_COMPLETED // assessment.completed (free assessments only)
  ASSESSMENT_COMPLETED_PAID // completed_paid (paid mode, on payment)
  ASSESSMENT_COMPLETED_UNPAID // completed_unpaid (paid mode, completed + no payment after 30 min)
  RESULT_GENERATED // result.generated
  RESULT_VIEWED // result.viewed
  ASSESSMENT_ABANDONED // assessment.abandoned
  RESULT_LINK_REQUESTED // result.link_requested (returning user asks to be emailed their prior result)
  CTA_CLICKED // booking_requested (respondent clicked the result page's booking CTA)
  SUBSCRIPTION_CANCELLED // subscription.cancelled (a paying customer asked to stop)
  // Appointment lifecycle (Calendar). BOOKED fires when a respondent or the owner
  // books a 1:1 slot; ATTENDED / NO_SHOW are marked by the owner afterwards, which
  // is what carries the real outcome of the call back to the CRM and to Meta.
  APPOINTMENT_BOOKED // appointment.booked
  APPOINTMENT_RESCHEDULED // appointment.rescheduled
  APPOINTMENT_CANCELLED // appointment.cancelled
  APPOINTMENT_ATTENDED // appointment.attended (showed up)
  APPOINTMENT_NO_SHOW // appointment.no_show
}

// ---------------------------------------------------------------------------
// EventLog - append-only ledger. ALWAYS written when an event is emitted,
// independent of webhook delivery. Powers the Events feed + audit + replay.
// ---------------------------------------------------------------------------

model EventLog {
  id        String    @id @default(cuid())
  type      EventType
  name      String // dotted public name, e.g. "assessment.completed"
  payload   Json
  source    String    @default("assess360") // future: "external" for ingested events
  createdAt DateTime  @default(now())

  submissionId String?
  assessmentId String?
  leadEmail    String?

  // Owning tenant (null = platform/Gita). Scopes the webhook-logs view per tenant.
  tenantId String?

  @@index([type])
  @@index([createdAt])
  @@index([submissionId])
  @@index([tenantId, createdAt])
  @@map("event_log")
}

// ---------------------------------------------------------------------------
// Webhook - a webhook IS the event definition. Keyed by event name (immutable,
// unique). Lifecycle: ACTIVE <-> INACTIVE; Purge deletes the row (config only -
// EventLog/WebhookLog history is never deleted). Routing + registry are one.
// ---------------------------------------------------------------------------

enum WebhookStatus {
  ACTIVE
  INACTIVE
}

model Webhook {
  id               String        @id @default(cuid())
  // The internal event that TRIGGERS this webhook (delivery matches on this, not
  // on name) - so the name is free for the CRM. Many webhooks may share a trigger.
  eventType        EventType
  // The delivered event identifier (free format: lowercase, "." or "_"). Becomes
  // event / event_type / contact.event_type in the payload. Name is editable only
  // until the first successful delivery (then frozen to protect a working CRM
  // mapping); the URL stays editable. The name is NO LONGER globally unique - the
  // same event may fan out to several endpoints (multiple CRMs). Only an exact
  // (tenant, name, url) triple is blocked (see @@unique), so a duplicate endpoint
  // can't be added twice.
  name             String
  url              String
  status           WebhookStatus @default(ACTIVE)
  secret           String // HMAC-SHA256 signing secret for X-Assess-Signature
  // Set on the first successful (2xx) delivery; once set, name/url are locked.
  firstDeliveredAt DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  // Owning tenant. null = platform/Gita (the existing global webhooks). Delivery
  // fires only to webhooks whose tenantId matches the emitting submission's tenant.
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Block an exact duplicate endpoint for the same tenant. NOTE: Postgres treats
  // NULLs as distinct, so this does NOT catch dupes among null-tenant (platform)
  // rows - createWebhook/editWebhook enforce that case at the application layer.
  @@unique([tenantId, name, url])
  @@index([status])
  @@index([eventType, status])
  @@index([tenantId, eventType, status])
  @@map("webhook")
}

// ---------------------------------------------------------------------------
// WebhookLog - one row per delivery attempt; supports inspection + retry.
// ---------------------------------------------------------------------------

model WebhookLog {
  id             String   @id @default(cuid())
  eventName      String
  endpoint       String
  payload        Json
  responseStatus Int?
  responseBody   String?
  error          String?
  attemptCount   Int      @default(1)
  success        Boolean  @default(false)
  createdAt      DateTime @default(now())

  // Plain reference (no FK) so purging a Webhook never affects log history.
  webhookId String?

  submissionId String?

  // Owning tenant (denormalized from the webhook/submission) for scoped log views.
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([eventName])
  @@index([success])
  @@index([createdAt])
  @@index([tenantId, createdAt])
  @@map("webhook_log")
}

// ---------------------------------------------------------------------------
// WebhookDelivery - durable delivery QUEUE (one row per webhook per event). A
// pending row survives a deploy/restart, so the retry cron (lib/webhooks/retry.ts)
// can re-attempt with backoff even when the inline first attempt is killed
// mid-flight. url/secret/body are denormalized so a retry is byte-identical and
// independent of later webhook edits. WebhookLog remains the per-attempt audit.
// ---------------------------------------------------------------------------

model WebhookDelivery {
  id            String    @id @default(cuid())
  webhookId     String // plain ref (no FK), like WebhookLog
  eventName     String
  endpoint      String
  secret        String
  body          String    @db.Text // exact JSON string that is signed + sent
  status        String    @default("pending") // pending | delivered | dead
  attemptCount  Int       @default(0)
  nextAttemptAt DateTime  @default(now()) // due time; also the claim lease marker
  lastStatus    Int?
  lastError     String?
  submissionId  String?
  tenantId      String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deliveredAt   DateTime?

  @@index([status, nextAttemptAt])
  @@index([webhookId])
  @@map("webhook_delivery")
}

// ---------------------------------------------------------------------------
// CrmSendQueue - the throttled background send queue for the SCORE and CUSTOM
// CRM senders. One row per job. The worker drains PENDING rows of its kind
// oldest-first, inside a daily IST window, with a random delay between sends.
// Contact fields are denormalized so the pending viewer needs no join and
// survives later edits. @@unique([kind, submissionId]) dedups re-enqueues.
// ---------------------------------------------------------------------------

enum CrmSendKind {
  SCORE
  CUSTOM
}

enum CrmSendStatus {
  PENDING
  SENDING
  SENT
  FAILED
}

model CrmSendQueue {
  id           String        @id @default(cuid())
  kind         CrmSendKind
  submissionId String
  status       CrmSendStatus @default(PENDING)
  attempts     Int           @default(0)
  lastError    String?
  contactName  String?
  contactEmail String?
  contactPhone String?
  queuedAt     DateTime      @default(now())
  sentAt       DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@unique([kind, submissionId])
  @@index([kind, status, queuedAt])
  @@map("crm_send_queue")
}

// ---------------------------------------------------------------------------
// Payment - one row per recorded payment (forward-compatible across use cases).
// NOW: purpose="assessment_unlock" (pay to see results), tied to a submission.
// LATER (SaaS tiers): purpose="subscription" with plan="starter"/"pro". The same
// table + webhook handle both. No FK to submission - payment history must persist.
// ---------------------------------------------------------------------------

model Payment {
  id                String    @id @default(cuid())
  provider          String    @default("razorpay")
  providerPaymentId String?   @unique // razorpay payment id - dedups webhook retries
  providerOrderId   String?
  providerLinkId    String? // razorpay payment_link id
  // WHICH Razorpay account took the money: "GST" (the tenant's primary keys) or
  // "NON_GST" (the second, optional account some tenants bill clients on). Null on
  // every row written before the second account existed, which reads as GST - the
  // only account there was. Carried so revenue can be split for accounting without
  // reconciling against two dashboards by hand.
  providerAccount   String?
  purpose           String // "assessment_unlock" | "product_sale" | (future) "subscription"
  plan              String? // future: "starter" | "pro"
  submissionId      String?
  amount            Int? // paise
  currency          String    @default("INR")
  status            String // "paid" | "captured" | …
  method            String? // card / upi / netbanking / …
  event             String? // razorpay event that recorded it
  notes             Json?
  // Set when the Meta Purchase conversion (CAPI) was confirmed sent for this
  // payment - null = never fired. Authoritative answer to "did Meta get this sale".
  metaConversionAt  DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // Owning tenant (denormalized from the submission; null = platform/Gita).
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  // Owning assessment (denormalized from the submission) for per-assessment revenue.
  assessmentId String?

  @@index([submissionId])
  @@index([purpose])
  @@index([tenantId, createdAt])
  @@index([assessmentId, createdAt])
  @@map("payment")
}

enum PaymentHandoffStatus {
  PENDING
  CONSUMED
}

/**
 * EXTERNAL-GATEWAY return ticket.
 * A tenant using their own payment link (not Razorpay keys) configures ONE success
 * URL on their gateway, the same string for every respondent, so the return cannot
 * carry a per-person token. This row is the per-person half: created the moment we
 * send someone to the payment link, matched on the way back by a nonce held in an
 * httpOnly SameSite=Lax cookie on our own host.
 * Single use is a property of THIS ROW, not of the URL: the second arrival with the
 * same nonce finds CONSUMED and unlocks nothing.
 * 🔴 What this proves is that a browser came back from the gateway, NOT that money
 * moved. It cannot see a failed or refunded payment, and someone who abandons on the
 * payment page and navigates to the return URL in the same browser inside the window
 * unlocks the result. That is the stated cost of taking no gateway integration. A
 * tenant who needs proof uses their own Razorpay keys and the real webhook.
 */
model PaymentHandoff {
  id           String               @id @default(cuid())
  tenantId     String
  tenant       Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  submissionId String
  /**
   * The cookie value. Unguessable and unique, so a lookup needs the cookie.
   */
  nonce        String               @unique
  status       PaymentHandoffStatus @default(PENDING)
  /**
   * Lowercased email, for the fallback when the cookie is lost (the payment page
   * opened in a different browser - routine from the Instagram in-app browser).
   */
  email        String?
  /**
   * Whatever the gateway appended on return, when it appends anything. Recorded for
   * reconciliation; never trusted as proof of payment.
   */
  reference    String?
  createdAt    DateTime             @default(now())
  expiresAt    DateTime
  consumedAt   DateTime?

  @@index([tenantId, email, status])
  @@index([submissionId])
  @@index([expiresAt])
  @@map("payment_handoff")
}

enum PaymentLinkStatus {
  CREATED // generated, not paid yet - the only state that can be cancelled
  PAID // settled once, and therefore spent: the page refuses a second payment
  CANCELLED // withdrawn by the operator before anyone paid
}

// ---------------------------------------------------------------------------
// PaymentLink - a one-shot collection link an operator generates for ONE person
// from the Submissions screen, copies, and sends by hand.
//
// It is NOT a Razorpay payment link. A Razorpay link fixes its amount at creation
// and gives the payer no way to change it, and the ask here is the opposite: the
// client sets the amount. So the link points at OUR page (/pay/<token>), which shows
// their details already filled in and an editable amount, and opens Razorpay
// Checkout against an Order created when they press pay.
//
// One link, one payment. On a settled payment the row goes PAID and the page stops
// accepting money - "expires after payment", with no time expiry at all, because a
// link nobody has paid yet is not dangerous and the operator simply generates the
// next one when the next amount is due.
//
// The TOKEN is the whole access control: unguessable, bound to one submission, and
// the only thing the public page is given. The amount the browser sends is checked
// against minPaise/MAX here, never trusted.
// ---------------------------------------------------------------------------
model PaymentLink {
  id String @id @default(cuid())

  /// The unguessable half of the public URL. Unique, so /pay/<token> is a lookup.
  token String @unique

  /// Owning tenant, with the SAME convention every other money row uses: null means
  /// the platform's own funnels (Apply Gita), whose submissions still carry a null
  /// tenant because the re-home data move has not been run. Making this column
  /// required would have made the owner's own funnels the one place the feature could
  /// not be used.
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  /// Who this was generated for, denormalized alongside for reporting. No FK to the
  /// submission: a sale must survive the lead record being deleted.
  submissionId String
  assessmentId String?

  /// "GST" | "NON_GST" - which of the tenant's two Razorpay accounts signs the order
  /// and verifies the return. Chosen when the link is generated and never inferred
  /// afterwards, because the keys that signed an order are the only keys that can
  /// verify its payment.
  account String @default("GST")

  /// What the operator typed, shown as the prefilled figure. The client may change
  /// it - that is the point of the page - so this is a suggestion, not the price.
  amountPaise Int

  /// Floor enforced SERVER-SIDE on whatever the client types. The payer sets the
  /// amount, so without a floor a sale can arrive as ₹1.
  minPaise Int @default(100)

  /// Overrides the tenant's standing description for this one link, when the sale
  /// needs naming (a package, a retainer). Blank = the tenant's setting.
  description String?

  status PaymentLinkStatus @default(CREATED)

  /// The Razorpay Order the client's chosen amount created, and the payment that
  /// settled it. Both null until they press pay.
  providerOrderId   String?
  providerPaymentId String?

  /// What was ACTUALLY paid, which is the client's figure and not necessarily
  /// amountPaise. This is the number that belongs in revenue.
  paidPaise Int?
  paidAt    DateTime?

  /// The operator who generated it. Plain scalar, not a relation: the record of who
  /// sent a money link must outlive the staff account that sent it.
  createdByUserId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([submissionId])
  @@index([tenantId, createdAt])
  @@index([status])
  @@map("payment_link")
}

// ---------------------------------------------------------------------------
// AppSetting - singleton platform settings (configurable automation knobs).
// ---------------------------------------------------------------------------

// ---------------------------------------------------------------------------
// CapiLog - one row per captured Razorpay payment: the record of the Purchase
// CAPI event (auto-fired for configured amounts, else pending for manual firing)
// plus Meta's actual response. The audit trail for "what did we send and what did
// Meta say". Deduped by the Razorpay payment id.
// ---------------------------------------------------------------------------

model CapiLog {
  id                String    @id @default(cuid())
  providerPaymentId String?   @unique // razorpay payment id = the Meta event_id
  email             String?
  phone             String?
  name              String?
  amountPaise       Int?
  currency          String    @default("INR")
  eventName         String // Purchase, or the high-ticket event name
  matched           Boolean   @default(false) // attribution found from a submission
  autoFired         Boolean   @default(false) // fired automatically (vs manual)
  status            String    @default("pending") // pending | sent | failed
  httpStatus        Int?
  response          String? // Meta's response body (truncated) or the error
  submissionId      String?
  firedAt           DateTime?
  createdAt         DateTime  @default(now())

  // Owning tenant (denormalized from the submission; null = platform/Gita).
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  // Which AD ACCOUNT this event was sent to (null = the tenant's default at fire time).
  //
  // 🔴 Stamped so a DEFERRED fire resolves the same pixel the funnel does. A pending or
  // failed row is fired later - minutes or days later, by the auto path or by hand from
  // the log viewer - and before this column the only scope it carried was the tenant, so
  // a funnel running on the tenant's second ad account had its Purchase re-fired against
  // the FIRST one. Nothing errors: the event is accepted, by the wrong dataset, and the
  // first symptom is an ad account reporting a sale it never produced.
  //
  // No foreign key, deliberately. The row is a historical record of where an event went,
  // and if that account is later deleted the honest outcome is a fire that REFUSES (the
  // resolver returns nothing for an id it cannot match) rather than one that silently
  // falls back to the default pixel - which is the exact failure this column prevents.
  adAccountId String?

  // Which funnel this event belongs to. Both funnels write rows with tenantId null
  // and the same standard event names, so without this they are indistinguishable -
  // an assessment opt-in and an Assess360 signup both read "CompleteRegistration".
  // "assessment" = the respondent funnel (per-tenant / Gita pixel).
  // "platform"   = the Assess360 SaaS funnel (signup + subscription, platform pixel).
  scope String @default("assessment")

  @@index([status])
  @@index([createdAt])
  @@index([tenantId, createdAt])
  @@index([scope, createdAt])
  @@map("capi_log")
}

// ---------------------------------------------------------------------------
// AiPromptVersion - a tenant-authored "instructions for the system prompt". The
// owner writes plain instructions (how to shape the message from the scores); the
// app assembles the real system prompt = fixed scaffold + these instructions. The
// built-in code versions (v1-mentor/v2-easy-read) stay in code; DB ones start at V3.
// ---------------------------------------------------------------------------
model AiPromptVersion {
  id           String   @id @default(cuid())
  tenantId     String? // null = platform/Gita
  tenant       Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  number       Int // display number: V3, V4, … (per tenant, continues past the 2 built-ins)
  label        String
  instructions String   @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([tenantId, number])
  @@index([tenantId])
  @@map("ai_prompt_version")
}

model AppSetting {
  id       String  @id @default("singleton")
  // Owning tenant. The PLATFORM's config is the id="singleton" row, whose tenantId is
  // set to "platform" by the re-home - so that one row is reachable both by its id and
  // by its tenant, and all addressing goes through lib/settings/tenant-row so the two
  // names can never create a second row. Each tenant gets ONE additional row. A tenant
  // NEVER reads the singleton (so the platform's own keys stay private) - an
  // unconfigured tenant simply has no AI, and no pixel, CAPI or checkout either.
  tenantId String? @unique
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  abandonedAfterHours Int @default(24)

  // Legal / company details shown ONLY on the public policy pages (/privacy,
  // /terms, /refund) - never on the marketing landing. Read from the singleton row
  // by those pages and substituted into the India-focused policy copy. Blank =
  // a visible placeholder telling the owner to fill it in Settings.
  legalEntityName        String?
  legalAddress           String?
  legalContactEmail      String?
  legalGoverningLocation String? // e.g. "Bengaluru, Karnataka" - governing-law seat

  // Two more entity facts, kept in the SAME row as the rest of the legal details so
  // there is one place to edit them. These feed the public JSON-LD Organization as well
  // as the policy pages: GSTIN is a public tax identifier, and foundedOn is an ISO
  // year-month ("2024-02") because schema.org foundingDate accepts a partial date and a
  // day we do not have would be invented precision.
  legalGstin     String?
  legalFoundedOn String?

  // Support contact shown to RESPONDENTS. When a tenant is over its response cap, a
  // lead who finishes the assessment sees a neutral "results unavailable - contact
  // support" screen instead of their scorecard, with this address. Blank = no address
  // shown (the screen still renders, just without a mailto). Per-tenant; the singleton
  // row holds the platform/Gita fallback.
  supportEmail String?

  // AI personalized-statement config (platform-level). The API key is stored
  // ENCRYPTED at rest (see lib/crypto) and never returned to the client.
  aiEnabled      Boolean @default(false)
  aiProvider     String? // "claude" | "openai" | "gemini" - which provider to USE
  aiModel        String?
  // Legacy single key (kept for back-compat/fallback). New keys are stored PER
  // provider below, so switching provider/model never re-prompts or breaks.
  aiApiKeyEnc    String?
  // One ENCRYPTED key per provider, saved once and reused. The active provider
  // (aiProvider) selects which of these is used at generation time.
  aiClaudeKeyEnc String?
  aiOpenAiKeyEnc String?
  aiGeminiKeyEnc String?

  // ADMIN keys, platform row only. A DIFFERENT credential from the keys above: an
  // Anthropic admin key starts sk-ant-admin and only an org admin can mint one. They
  // read the organisation's real billed cost, which is the only way the expense in
  // this app can be the same number as the invoice. Nothing generates with them.
  aiClaudeAdminKeyEnc String?
  aiOpenAiAdminKeyEnc String?

  /// Which API key id inside the provider organisation is THIS product's.
  ///
  /// The cost report bills an organisation, not a product. Assess360 and the other
  /// apps share one Anthropic account separated only by API key, so the day's real
  /// spend is split by each key's share of that day's tokens. Blank = take the whole
  /// organisation's bill as ours, which is only right on a dedicated account.
  aiClaudeApiKeyId String?
  aiOpenAiApiKeyId String?
  aiGuidance       String?
  // Default result-statement prompt version - the tenant-wide default that a new
  // assessment inherits (an assessment can override via Assessment.aiPromptVersionId).
  // May be a built-in code id ("v1-mentor"/"v2-easy-read") or an AiPromptVersion id.
  aiPromptVersion  String?
  // Tenant-wide word-count window the assembled system prompt asks the model for.
  aiWordMin        Int     @default(200)
  aiWordMax        Int     @default(280)

  // Per-tenant Meta (ads) config. On the singleton these stay null and the code uses
  // the platform env (NEXT_PUBLIC_META_PIXEL_ID / META_CAPI_ACCESS_TOKEN); a tenant
  // stores its OWN. The CAPI token is ENCRYPTED at rest. Wiring (client pixel + CAPI
  // fire) resolves these per tenant - null tenant => env, unchanged.
  // NOTE: this pixel tracks ASSESSMENT RESPONDENTS (the Gita funnel).
  metaPixelId      String?
  metaCapiTokenEnc String?

  /// "We don't use Meta" - the tenant's explicit opt-out of the publish lock.
  ///
  /// Publishing needs a pixel AND a CAPI token, or this. A funnel published with
  /// neither collects leads and reports nothing, which to the person paying for the
  /// traffic is indistinguishable from a broken product.
  ///
  /// It is a flag rather than an inference because "no pixel" has two meanings that
  /// deserve different outcomes: "we do not advertise on Meta" is fine, and "we have
  /// not set it up yet" is the mistake. Only the tenant can say which one it is.
  metaNotUsed Boolean @default(false)

  // Platform / app SUBSCRIPTION funnel pixel - a SEPARATE Meta pixel for Assess360's
  // own SaaS funnel: landing PageView, free-signup CompleteRegistration, and the
  // subscription Purchase. Distinct from metaPixelId above (which is the Gita
  // assessment pixel). Only meaningful on the singleton row (platform-owned); the
  // CAPI token is ENCRYPTED at rest. No env fallback - unset = the funnel fires nothing.
  platformPixelId String?

  /// Onboarding video shown to a tenant on their first screen while they are in trial.
  /// Platform-wide (set once by the super admin), because it explains Assess360 rather
  /// than anything about one workspace. Blank = the written steps appear on their own,
  /// which is the point: the steps are the instruction, the video is the nicety.
  /// The done-for-you scarcity counter, shown on /build and the home page.
  ///
  /// Two REAL numbers a human edits, never a timer that resets itself. The whole point
  /// of the claim is that it is checkable: "7 of 20 free builds remaining" is worth
  /// something only while somebody is actually decrementing it, and a counter that
  /// refills overnight is the kind of thing a buyer notices once and never forgets.
  ///
  /// `dfyBuildsRemaining` null = show NOTHING. An unset counter claims nothing at all,
  /// which is the correct default: a number nobody is maintaining should disappear
  /// rather than quietly go stale in front of buyers.
  dfyBuildsTotal     Int  @default(20)
  dfyBuildsRemaining Int?

  /// ---------------------------------------------------------------------------
  ///  The one call to action, editable without a deploy.
  /// ---------------------------------------------------------------------------
  ///
  /// Every CTA on every public surface reads these three values: the landing page,
  /// the industry pages, /pricing, the comparison pages, the offer bar and the nav
  /// button. They used to be constants in src/lib/marketing/content.ts, which meant
  /// changing the offer was a code edit and a deploy - and an offer that costs a
  /// deploy to change is an offer nobody changes.
  ///
  /// NULL / blank means "use the constant in content.ts", so clearing a field puts
  /// the shipped copy back rather than printing an empty button. That is the one
  /// behaviour this needs to be safe: a half-finished edit cannot produce a page
  /// with a blank or dead button on it.
  ///
  /// `ctaHref` is a path on this app ("/a/paying-for-junk-leads") or an absolute
  /// https URL. It is operator-set and never request input, so it is not an
  /// open-redirect surface - but it IS rendered into every button, which is why the
  /// action that writes it validates the shape rather than trusting the field.
  ctaHref       String?
  /// The trial-framed label (nav, hero secondary, the priced tiers, the SEO blocks).
  ctaTrialLabel String?
  /// The free-build-framed label (hero primary, metering, the comparison and
  /// industry offer blocks, the calculator).
  ctaDfyLabel   String?

  /// The approved Meta template fired when somebody submits the /build intake.
  ///
  /// Blank = no WhatsApp is sent, and that is the shipping default. A template has to be
  /// submitted and approved inside Meta Business Manager before it can be used at all,
  /// which is an account action nobody can perform from this app - so the send stays
  /// dormant until a real approved name is pasted here, rather than failing on every
  /// submission and filling the log with rejections nobody can fix from inside the app.
  ///
  /// The body takes ONE variable, the business name: a template's variable count is fixed
  /// at approval time, and a mismatch is rejected by the API rather than degraded.
  dfyWabaTemplate String?
  dfyWabaLang     String?

  onboardingVideoUrl String?

  /// The getting-started steps every tenant sees on their dashboard during trial, in
  /// order. Shape: ["first step", "second step", ...].
  ///
  /// Authored by the platform owner rather than hardcoded, because the right first
  /// steps change as the product does, and a sequence that has drifted out of date
  /// teaches a new customer the wrong thing on the one day they are paying attention.
  /// Empty/absent means no panel at all - an empty instruction list is worse than none.
  onboardingSteps      Json?
  platformCapiTokenEnc String?

  // Per-tenant Razorpay config (all ENCRYPTED except the public key id). null on the
  // singleton => platform env. Webhook routing per tenant is part of the fire wiring.
  razorpayKeyId            String?
  razorpayKeySecretEnc     String?
  razorpayWebhookSecretEnc String?

  // The SECOND, optional Razorpay account - the one whose invoices carry no GST,
  // kept for clients who will not pay the tax on top. Same three fields, stored the
  // same way, read through a DIFFERENT accessor.
  //
  // 🔴 THIS ACCOUNT CAN NEVER TAKE A PLATFORM SUBSCRIPTION. Billing resolves its keys
  // through resolveRazorpayConfig(null), which serves the GST columns above and takes
  // no account argument - so there is no call path, and no mistake a future edit can
  // make, that charges an Assess360 subscription on these keys. They exist for one
  // purpose: collecting from a tenant's OWN clients.
  //
  // Both accounts are optional and neither is ever required: a tenant that collects
  // no money at all leaves all six fields blank and nothing in the product asks for
  // them. Blank simply means that account is not offered where an account is chosen.
  razorpayNonGstKeyId            String?
  razorpayNonGstKeySecretEnc     String?
  razorpayNonGstWebhookSecretEnc String?

  /// What the client reads on the payment page and on their Razorpay receipt, e.g.
  /// "Consulting retainer - Divine Leads". One line per tenant, edited in Settings
  /// rather than hardcoded, because it is the tenant's business name on someone
  /// else's card statement. Blank falls back to a line built from the assessment.
  paymentLinkDescription String?

  // WELCOME EMAIL sent once when a new workspace is provisioned at signup. Singleton
  // row only - it is a platform message, not a tenant's marketing. Body is HTML with
  // the same placeholder style as the nurture templates.
  //
  // 🔴 A password is NEVER placed in this email, and there is no placeholder for one.
  // Self-serve signups choose their own, and mailing a credential turns every inbox
  // into a copy of the account. The template offers a reset LINK instead.
  welcomeEmailEnabled Boolean @default(false)
  welcomeEmailSubject String?
  welcomeEmailBody    String? @db.Text

  // Which MODEL each plan's tenants generate with, as DATA rather than a constant:
  // { "GATE": "claude-haiku-4-5", "SIGNAL": "claude-haiku-4-5", ... }. Meaningful only
  // on the singleton row, and only for tenants running on the platform's own key.
  //
  // The point of per-plan binding is cost: the tenant chooses the words, the owner
  // chooses what those words cost to produce. Unset falls back to the code default
  // (Haiku), so the column being empty is a working configuration, not a broken one.
  aiPlanModels Json?

  // WHATSAPP, parked. Meaningful only on the singleton row. The WABA sender works but
  // needs real work before it is handed to customers: template approval, per-tenant
  // numbers and the failure modes that come with both. Hiding it is the honest state,
  // and hiding it behind a switch rather than deleting the code means turning it back
  // on is a click rather than a revert.
  //
  // Default FALSE: hidden for customers. The owner's own INTERNAL tenants
  // (Tenant.unlimited) always see it regardless, because they are already using it.
  // The consent line shown under every opt-in form, per tenant. Blank falls back to
  // the wording in code, so a workspace that never touches this still shows something
  // honest. Stored ON THE CONTACT at capture time as well, because what matters later
  // is what the person actually saw, not what the setting says today.
  consentText String? @db.Text

  wabaEnabledGlobal Boolean @default(false)

  // THE META APP behind one-click WhatsApp onboarding. Singleton row ONLY: there is one
  // developer app (ours) and every tenant connects their own WABA through it, which is
  // what being a Tech Provider means. A tenant never sees or sets these.
  //
  // Not env vars, deliberately. Settings over env is the rule here, and these change
  // when the app is re-created or the secret is rotated - neither should need a deploy.
  //
  // metaEsConfigId is the Facebook Login for Business CONFIGURATION id, and it is also
  // what pins the flow to Embedded Signup v4: the version is chosen by which products
  // that configuration selects, not by anything we send. v2 was deprecated on
  // 15-10-2026, so a configuration made before that is not safe to reuse.
  metaAppId                 String?
  metaAppSecretEnc          String?
  metaEsConfigId            String?
  // Shared secret echoed back to Meta on webhook verification (GET hub.challenge).
  // Ours to invent; stored encrypted because it is a bearer-ish secret.
  metaWebhookVerifyTokenEnc String?

  // PLATFORM MASTER SWITCH for respondent payments, meaningful ONLY on the singleton
  // row. False = no tenant funnel can take money, whatever its own switch or its
  // assessments say. The owner is not in the business of underwriting how other
  // people collect payments, so there has to be one lever that stops all of it at
  // once without editing any tenant. Default true: existing behaviour.
  paymentsEnabledGlobal Boolean @default(true)

  // Analytics baseline. When set, the Stats + Contacts pages count only
  // records at/after this instant (a non-destructive "reset to 0").
  statsResetAt DateTime?

  // Heatmap / session-recording snippet (e.g. MS Clarity) injected on this tenant's
  // public funnel pages (/a/[slug] + result) so the whole opt-in → questions → submit
  // journey records. Stored verbatim (the admin pastes the vendor snippet); the outer
  // <script> wrapper is stripped at inject time so the inline JS runs. null/blank = off.
  // Platform/Gita assessments read the singleton row's value.
  heatmapCode String?

  // VidaPulse identity bridge: after the assessment, the in-app VSL page embeds a
  // VidaPulse video (iframe). When enabled, the opaque Submission.customerId (never
  // any PII) is appended to that embed's src under vidapulseParam, so VidaPulse can
  // bind its own customer/click record to ours. Enabled + "cid" by default (harmless
  // on any player - an unknown query param is ignored). null tenant => singleton value.
  vidapulseTrackingEnabled Boolean @default(true)
  vidapulseParam           String  @default("cid")

  // Purchase CAPI: captured amounts (₹, CSV) that AUTO-FIRE the Purchase event on
  // payment.captured. Every other captured amount is logged as "pending" for manual
  // firing. Amounts strictly above the high-ticket threshold fire under a distinct
  // event name (owner-set) instead of "Purchase".
  purchaseAutoFireAmounts     String @default("199,499,999,1000")
  purchaseHighTicketThreshold Int    @default(4000)
  purchaseHighTicketEventName String @default("Purchase")

  // Platform password-reset webhook: assess360 POSTs the reset link here; the CRM
  // catches it and emails the user. Platform-level (login is platform-wide), so it
  // lives on the singleton row. Null = fall back to env PASSWORD_RESET_WEBHOOK_URL.
  passwordResetWebhookUrl String?

  // Where a cancelling customer is sent after the cancellation is booked: the owner's
  // exit assessment, which asks why they left. Platform-level and owner-authored, so it
  // lives on the singleton row. Null = no exit step, the cancel just confirms.
  cancelExitAssessmentUrl String?

  // Per-tenant booking/calendar link (Calendly/Cal.com/etc). The respondent
  // results page renders a "Book a 1-on-1 call" CTA pointing here; null = hide it.
  bookingUrl String?

  // Marketing landing videos - PLATFORM ONLY, never copied to a tenant.
  // { hero?: string, tiles?: { "<capability title>": string } }. Each value is the
  // embed code or URL exactly as pasted; it is re-validated against the host allowlist
  // on every read (lib/marketing/embed), so nothing author-supplied is trusted merely
  // because it was trusted once. Blank/absent = the hero image renders and the tiles
  // look exactly as they do today.
  landingVideos Json?

  // Cloudflare R2 object storage - PLATFORM level, one bucket for the whole install.
  // Per-tenant isolation is by KEY PREFIX inside that bucket (tenants/<id>/...), not by
  // separate buckets or credentials: one set of keys to rotate, and a tenant never
  // holds credentials that could reach another tenant's objects.
  //
  // Configured here rather than in environment variables, like every other integration
  // - env holds only what the app needs to boot. The secret is encrypted at rest.
  r2AccountId          String?
  r2AccessKeyId        String?
  r2SecretAccessKeyEnc String?
  r2BucketName         String?
  // Public base URL of the bucket (or its custom domain). Only used for objects meant
  // to be world-readable; private files are served through short-lived signed URLs.
  r2PublicUrl          String?

  // DEPRECATED - superseded by the AudienceList table (named lists an assessment can
  // pick between). The migration copied each non-empty array here into a list called
  // "Default", marked default, and nothing writes this column any more. It is read ONLY
  // as a last-resort fallback for a tenant whose backfill found nothing, and goes away
  // once that is provably empty everywhere.
  audienceCanonical Json?

  // ---- Nurture (one-shot Email + WhatsApp on opt-in) - PER TENANT -----------
  // SMTP transactional email. Password ENCRYPTED at rest, never returned to the
  // client. Each tenant has its OWN sender; the singleton row is the platform/Gita
  // sender. No env fallback (new feature) - unconfigured => that channel just no-ops.
  smtpHost               String?
  smtpPort               Int?
  smtpSecure             Boolean   @default(false)
  smtpUser               String?
  smtpPassEnc            String?
  smtpFromName           String?
  smtpFromEmail          String?
  // Meta WhatsApp Cloud API (business-initiated = approved TEMPLATE messages only).
  // Access token ENCRYPTED. apiVersion/countryCode fall back to code defaults when blank.
  wabaPhoneNumberId      String?
  // WhatsApp Business Account (WABA) id - the parent of the phone number. Needed to
  // LIST approved message templates (GET /{wabaId}/message_templates). Optional; only
  // the template picker uses it (sending needs just the phone number id + token).
  wabaBusinessAccountId  String?
  wabaAccessTokenEnc     String?
  wabaApiVersion         String? // e.g. "v21.0"
  wabaDefaultCountryCode String? // e.g. "91" - prepended to bare local mobiles for E.164
  // ---- Coexistence onboarding (Embedded Signup) ------------------------------
  // Filled by the one-click connect, never typed. The TOKEN still lands in
  // wabaAccessTokenEnc above, so the sender and resolveWabaConfig are untouched: this
  // block is only the provenance and the identity of what got connected.
  //
  // Coexistence means the number stays on the WhatsApp Business app on a phone AND
  // answers the Cloud API at the same time. The one call that would break that is POST /{number}/register,
  // which takes the number off the phone - so the connect flow never makes it, and
  // wabaIsOnBizApp records what Meta said the number actually is.
  wabaBusinessId         String? // Meta business portfolio id of the connected customer
  wabaDisplayPhone       String? // e.g. "+91 98765 43210", for showing what is connected
  wabaVerifiedName       String? // the display name Meta approved for the number
  wabaIsOnBizApp         Boolean   @default(false)
  wabaOnboardedAt        DateTime?
  // Last failure, shown verbatim on the settings card. A connect that half-finishes is
  // the dangerous state, so the reason is kept rather than swallowed into a log nobody
  // reads. Cleared on the next success.
  wabaOnboardError       String?
  // The Nurture messages + on/off toggles, as JSON:
  //   { email: { enabled, subject, body }, waba: { enabled, template, lang, vars: string[] } }
  nurtureConfig          Json?

  // CRM "score_updated" resend: the destination endpoint (separate from the
  // configured webhooks) and a persisted "drip is active" flag for status/resume.
  // crmDripActive doubles as the SCORE worker's "armed" flag (boot-resume).
  crmResendUrl      String?
  crmDripActive     Boolean @default(false)
  // SCORE sender daily window (IST hours) + random delay between sends (minutes).
  crmScoreStartHour Int     @default(9) // inclusive, 0-23 IST
  crmScoreEndHour   Int     @default(21) // exclusive, 0-23 IST
  crmScoreDelayMin  Int     @default(10)
  crmScoreDelayMax  Int     @default(12)

  // CRM "diagnosis_update" backfill: its OWN automation endpoint, distinct from
  // crmResendUrl (which is the WhatsApp-firing score_updated automation). This is
  // now the generic CUSTOM sender's endpoint - refuses to run until set.
  crmDiagnosisUrl    String?
  // CUSTOM sender (was "Diagnosis"): fully configurable name, routing event_type,
  // selected payload fields, daily IST window, random delay, and armed flag.
  crmCustomName      String   @default("Diagnosis")
  crmCustomEventType String   @default("diagnosis_update")
  crmCustomFields    String[] @default(["contact_name", "contact_email", "contact_phone", "contact.event_type", "contact.assessment_diagnosis"])
  crmCustomStartHour Int      @default(9)
  crmCustomEndHour   Int      @default(21)
  crmCustomDelayMin  Int      @default(10)
  crmCustomDelayMax  Int      @default(12)
  crmCustomActive    Boolean  @default(false)

  /// How tickets and onboarding requests are HANDLED, one setting per kind.
  ///
  /// IN_APP  the tenant raises it here, the owner's rail badges it, the owner answers
  ///         in the thread, and the tenant is told by email and WhatsApp.
  /// EMAIL   the tenant still raises it here, but it is forwarded to the support inbox
  ///         and the conversation genuinely MOVES to email. No badge, no WhatsApp.
  /// OFF     the raise form is withdrawn. Threads already open stay readable.
  ///
  /// Two settings and not one, because the two queues fill at different rates: a
  /// product with a hundred tenants gets onboarding questions constantly and real
  /// faults rarely, and the owner has to be able to hand one of them to a support
  /// team without going blind to the other.
  ///
  /// Strings and not an enum, deliberately, following dfy_request.status: this is an
  /// operational routing choice that will be renamed while the support process is
  /// being worked out, and renaming a Postgres enum value costs a migration.
  supportMode    String @default("IN_APP")
  onboardingMode String @default("IN_APP")

  /// Where EMAIL mode forwards to. A mode that forwards nowhere is a black hole, so
  /// the setter refuses to save EMAIL while this is blank.
  supportInboxEmail String?

  /// Where a reply is announced to the outside world, as one POST.
  ///
  /// WhatsApp is NOT sent from here. The owner's CRM already holds the approved
  /// templates, the opt-in state and the sending number, and a second sender inside
  /// this app would be a second place to approve a template, a second number to keep
  /// warm and a second set of sends to reconcile. This app states the fact (there is a
  /// reply on AS-1042, here is the link, here is the person); the CRM decides what to
  /// do about it.
  ///
  /// Blank = nothing is posted, which is the shipping state and a working one: the
  /// reply email still goes out on its own.
  ///
  /// The payload uses the flat contact_name / contact_email / contact_phone keys the
  /// owner's CRM automations already map, plus event_type "support_reply".
  supportWebhookUrl String?

  /// PLATFORM ONLY, read from the singleton row: the one Google OAuth app the whole
  /// product connects through.
  ///
  /// Not per tenant, and not in the environment. Not per tenant because a tenant does
  /// not have a Google Cloud project and should never be asked for one - they click
  /// Connect and consent. Not in the environment because every other credential in this
  /// app moved in-app for the same reason: an env edit plus a redeploy is not a setting.
  ///
  /// The redirect URI registered with Google is the PLATFORM origin plus
  /// /api/google/callback, which is why connecting always happens on the platform
  /// domain even for a tenant on their own: Google matches the redirect exactly, and no
  /// OAuth app can enumerate every customer domain.
  googleClientId        String?
  googleClientSecretEnc String?

  /// Secret in the CALENDAR SUBSCRIPTION URL (/api/calendar/<token>.ics), so the
  /// workspace can read its bookings in Google Calendar, Apple Calendar or Outlook
  /// without this app holding anybody OAuth credentials.
  ///
  /// A capability token, which is why it is per workspace and rotatable: the URL is
  /// pasted into a calendar client that will fetch it forever with no session, so the
  /// only way to revoke a leaked subscription is to change the token. Null = no feed
  /// has been generated yet (the page generates one on first ask).
  calendarFeedToken String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("app_setting")
}

/// One rejection by the Page-1 qualification gate. The gate creates NO lead /
/// submission / result, so before this model a disqualified visitor left no trace at
/// all and every in-app counter read 0 while Meta still counted the exclusion event.
/// ASSESSMENT FUNNEL ONLY - the SaaS signup + subscription paths have no gate and
/// never write here. High-write + fail-soft, mirroring PageView's conventions.
model GateDisqualification {
  id           String     @id @default(cuid())
  assessmentId String
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  visitorId    String
  createdAt    DateTime   @default(now())

  // Which gate answer rejected them. Null on a `repeat` row, where the visitor is
  // skipped straight to the exit page from the stored flag without re-answering.
  questionId String?
  optionId   String?

  // Which exit route they were sent to, by the exit's key. Null on a row written before
  // routes existed, and on a repeat the server could not attribute. Without it every
  // exit pools into one "disqualified" number, and a funnel cannot tell three rejections
  // from sixty people asking to be told about the next cycle.
  exitKey String?

  // When GateDisqualified was actually SENT to Meta for this rejection (server CAPI).
  // Null = nothing was sent for this row: a revisit Meta already knows about, a
  // funnel with the event switched off, or a send that failed. Replaces the old
  // localStorage `firedAt` stamp - the browser no longer fires this event, so the
  // audience-refresh decision has to be readable server-side.
  capiFiredAt DateTime?

  // FALSE = a fresh rejection (a person answered a disqualifying option just now).
  // TRUE  = a revisit by an already-rejected visitor, short-circuited to the exit
  // page. Splitting these is the whole point: the Meta event count mixes both, so
  // "63 disqualified" can really be a dozen people returning. Human-facing metrics
  // count fresh rows only.
  repeat Boolean @default(false)

  // Marketing attribution, so a gate that rejects an entire campaign is visible.
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  utmTerm     String?
  utmContent  String?
  fbclid      String?
  gclid       String?

  // Automated-client flag + enrichment, identical in meaning to PageView's.
  isBot      Boolean @default(false)
  userAgent  String?
  ip         String?
  country    String?
  city       String?
  region     String?
  postalCode String?
  timezone   String?
  deviceType String?
  browser    String?
  os         String?

  // Owning tenant (denormalized from the assessment; null = platform/Gita). Scalar
  // only - no FK - matching PageView: high-write, already cascades via assessment.
  tenantId String?

  @@index([assessmentId])
  @@index([visitorId])
  @@index([createdAt])
  @@index([utmSource])
  @@index([utmCampaign])
  @@index([tenantId, createdAt])
  @@index([assessmentId, visitorId]) // "did we already report this visitor?"
  @@index([exitKey]) // per-route counts
  @@map("gate_disqualification")
}

/// One click on a result-page booking CTA ("Apply for your seat", "Book a call", …).
///
/// The thank-you page lives in the CRM, so without this row nobody can tell WHO asked
/// for a call - the click leaves the app and never comes back. The button therefore
/// routes through /api/cta/[submissionId]/[blockId], which writes this row and then
/// forwards to the real destination with the VidaPulse ids intact.
///
/// The owner notification is tracked ON THIS ROW rather than fired and forgotten: a
/// booking request must never be silently lost, so a failed send stays `pending` with a
/// backoff and is retried by the cron until it lands or the schedule is exhausted.
model CtaClick {
  id           String     @id @default(cuid())
  submissionId String
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  assessmentId String
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  // Owning tenant (denormalized from the submission; null = platform/Gita).
  tenantId     String?
  createdAt    DateTime   @default(now())

  // Which button block was clicked, and what it said/pointed at when clicked - the
  // page is editable, so the label and destination are snapshotted rather than looked
  // up later against a block that may have changed or been deleted.
  blockId        String
  label          String?
  destinationUrl String?

  ip        String?
  userAgent String?

  // Durable owner notification (native SMTP). "pending" until it lands; the cron
  // retries on the backoff below and marks "dead" only once the schedule is spent.
  notifyEmail         String?
  notifyStatus        String    @default("pending") // pending | sent | dead | skipped
  notifyAttempts      Int       @default(0)
  notifyNextAttemptAt DateTime?
  notifyError         String?
  notifiedAt          DateTime?

  @@index([submissionId])
  @@index([assessmentId])
  @@index([tenantId, createdAt])
  @@index([createdAt])
  @@index([notifyStatus, notifyNextAttemptAt])
  @@map("cta_click")
}

/// The shape of the funnel a template builds, named for what it is FOR rather than
/// for which columns it happens to set. A tenant picking from a list needs to know
/// "screens people" vs "screens then scores" vs "scores everyone" before they read a
/// single question.
enum TemplateShape {
  /// Qualification gate only: it decides who is worth talking to and stops there.
  GATE_ONLY
  /// Gate first, then the scored assessment for whoever passes.
  GATED_ASSESSMENT
  /// No gate - everyone who arrives takes the scored assessment.
  UNGATED_ASSESSMENT
}

/// Review state of a CONTRIBUTED template. Rows the platform authored are APPROVED
/// from birth; a tenant's contribution arrives PENDING and is only ever visible to
/// other tenants once the owner publishes it.
enum TemplateReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

/// A starting point a tenant can import into their workspace as a real assessment.
///
/// 🟡 A template is NOT an Assessment, deliberately. Flagging an assessment as
/// "template" was the obvious shortcut and it leaks everywhere: into the assessments
/// list, Stats, Submissions, the dashboard counts and the sitemap - and worst of all
/// it stays publicly reachable at /a/[slug], where a template can collect real
/// submissions from real people. A separate table cannot do any of that.
///
/// The funnel itself lives in `body`, in the SAME portable shape the export/import
/// format already uses (AssessmentBodyExport). That is the whole reason this is cheap:
/// every field, gate, result page and band that a transfer carries, a template carries,
/// and import is the code that already existed.
model Template {
  id       String        @id @default(cuid())
  /// Library slug - identifies the template, NOT the assessment it creates. The
  /// imported copy gets its own globally unique assessment slug at import time.
  slug     String        @unique
  title    String
  /// Audience bucket shown as a heading in the list, e.g. "Coaches", "Clinics".
  /// A plain string, not an enum: a new audience must not need a migration.
  category String
  /// One or two lines: who it is for and what it decides. Shown in the list.
  summary  String?
  shape    TemplateShape @default(GATED_ASSESSMENT)

  /// The portable assessment body (AssessmentBodyExport). Validated on import by the
  /// same zod schema the uploaded-file importer uses, so a malformed template fails
  /// loudly at import rather than producing a half-built assessment.
  body Json

  /// The result-statement instructions this template suggests. On import these become
  /// an AiPromptVersion OWNED BY THE IMPORTING TENANT and are selected on the new
  /// assessment, so the tenant never copies and pastes a prompt. Null = no prompt,
  /// which is how the "without the AI statement" templates ship.
  aiInstructions String? @db.Text

  /// Visible to tenants. Off = authored but not on the shelf yet, which is also where
  /// a contribution sits until the owner approves it.
  published    Boolean @default(false)
  displayOrder Int     @default(0)

  /// Seeded from a JSON file in the repo (src/features/templates/builtin). Re-seeding
  /// upserts these by slug and NEVER overwrites `published` or `displayOrder` - the
  /// owner's shelf decisions outlive a deploy, the content is versioned in git.
  builtin Boolean @default(false)

  /// This row's CONTENT was edited in the app, so the seeder leaves it alone.
  ///
  /// Without it, editing a built-in in the Template editor would save, work, and then
  /// silently revert on the next deploy when the seeder re-read the repo file. The row
  /// stays a built-in - same badge, same slug - it is just no longer downstream of the
  /// file. "Revert to the repo version" clears this and re-seeds that one row.
  seedLocked Boolean @default(false)

  /// PRIVATE template: non-null = this row belongs to one workspace and only that
  /// workspace ever sees it. Null = it is in (or awaiting) the master library.
  /// Cascades: a deleted tenant's private templates are theirs, not the platform's.
  ownerTenantId String?
  ownerTenant   Tenant? @relation("TemplateOwner", fields: [ownerTenantId], references: [id], onDelete: Cascade)

  /// CONTRIBUTION provenance: who sent it in, kept even after the tenant is gone
  /// (SetNull), because the library row stays and the credit for it should too.
  contributorTenantId String?
  contributorTenant   Tenant?              @relation("TemplateContributor", fields: [contributorTenantId], references: [id], onDelete: SetNull)
  contributorName     String?
  submittedAt         DateTime?
  reviewStatus        TemplateReviewStatus @default(APPROVED)
  reviewedAt          DateTime?
  /// Why it was rejected, shown back to the contributor.
  reviewNote          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published, category, displayOrder])
  @@index([ownerTenantId])
  @@index([reviewStatus])
  @@map("template")
}

// ---------------------------------------------------------------------------
// AdAccount - one Meta configuration a tenant can run funnels against.
//
// The pricing page has metered "ad accounts" (1 / 2 / 10 / 25) since launch while the
// product had no such concept: a tenant had exactly ONE Meta config, living as columns
// on its AppSetting row. This is that concept, and it is the first thing that has to
// exist before the published claim is true.
//
// 🔴 The platform's own pixel is NOT represented here. It lives in platformPixelId /
// platformCapiTokenEnc on the singleton and is read by a different path
// (resolvePlatformMetaConfig). Folding it in would give the SaaS funnel and a customer's
// funnel one shared table and two meanings for "default".
// ---------------------------------------------------------------------------

model AdAccount {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  /// What the tenant calls it, e.g. "Acme - AU". Theirs to name; never shown publicly.
  label String

  /// For a tenant the pixel id IS the dataset id, which is why there is no separate
  /// column. resolveMetaConfig has always returned it as both.
  pixelId      String?
  /// Encrypted at rest, like every other secret in this schema.
  capiTokenEnc String?

  /// The one used when an assessment names no ad account. Exactly one per tenant is
  /// enforced by a PARTIAL UNIQUE INDEX in the migration - Prisma cannot express
  /// "unique where isDefault", and without it two defaults make the resolver pick
  /// arbitrarily between two live pixels.
  isDefault Boolean @default(false)

  assessments  Assessment[]
  bookingTypes BookingType[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@map("ad_account")
}

// ---------------------------------------------------------------------------
// AudienceList - a NAMED list of roles a tenant maintains and an assessment picks.
//
// There used to be exactly one list per tenant (AppSetting.audienceCanonical), which
// meant every funnel on the workspace offered the same suggestions: a clinic funnel and
// a coaching funnel had to share one vocabulary, and the only way to serve both was a
// single list long enough to be useless to either.
//
// So the list becomes a row with a name, and an assessment names the one it wants
// (Assessment.audienceGate.listId). Nothing is forced to choose: a gate that names no
// list falls back to the tenant's default, which is what the old single list was
// migrated into - so every funnel that exists today keeps the suggestions it has.
//
// Labels live in a JSON array rather than a child table on purpose. A label has no
// attributes of its own, order is the author's, and dedupe already happens on save;
// a second table would buy nothing and cost a join on a page that renders an opt-in.
model AudienceList {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  /// What the tenant calls it, e.g. "Clinic roles". Unique per tenant so picking one
  /// from a dropdown is unambiguous.
  name String

  /// Trimmed labels, in the author's order. Deduped case-insensitively on save.
  items Json

  /// Used when an assessment's gate names no list. Exactly one per tenant is enforced
  /// by a PARTIAL UNIQUE INDEX in the migration (Prisma cannot express "unique where
  /// isDefault"), for the same reason as AdAccount: two defaults make the fallback pick
  /// arbitrarily, and nothing about that looks like an error from the outside.
  isDefault Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("audience_list")
}

// ---------------------------------------------------------------------------
// DfyRequest - an application for the done-for-you scorecard build.
//
// The home page's PRIMARY call to action lands here, so losing one is losing the
// conversion the whole page is built around. It is therefore STORED FIRST and
// notified second: the owner's email and WhatsApp are best-effort and a dead SMTP
// host must never be the reason an application disappeared. `notifiedAt` records
// whether the alert actually went out, so the ones that did not are findable.
//
// No tenant relation on purpose: an applicant is not a tenant yet, and most never
// will be - the offer exists to put a finished funnel in front of someone before
// they are asked to sign up for anything.
// ---------------------------------------------------------------------------

model DfyRequest {
  id String @id @default(cuid())

  // Who, and how to reach them. Email is here although the brief's field list stops at
  // ten: the same section asks for a confirmation EMAIL, which cannot be sent to a
  // WhatsApp number. Everything else is exactly the ten fields as specified.
  business String
  email    String
  whatsapp String
  website  String?

  // What they sell and to whom.
  sells         String
  pricePoint    String
  trafficSource String
  monthlyLeads  String

  /// The most important field on the form, and the only free-text one: who is a BAD
  /// lead for you. It is what the gate gets written from, so it is required and it is
  /// given room on the page rather than a single-line input.
  badLead String

  calendarLink    String?
  adAccountAccess Boolean @default(false)

  /// NEW | CONTACTED | BUILT | DECLINED. A string rather than an enum: this is an
  /// operational pipeline that will be renamed as the offer is run, and a renamed
  /// enum value costs a migration while a renamed string costs nothing.
  status String @default("NEW")

  /// When the owner's alert actually sent. Null = it never did, which is a row that
  /// needs chasing by hand rather than a silent loss.
  notifiedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@map("dfy_request")
}

// ---------------------------------------------------------------------------
// Support - in-app tickets and onboarding requests.
//
// ONE MODEL, TWO MENU ITEMS. A ticket and an onboarding request have the same
// lifecycle, the same notify path, the same badge and the same thread; `kind` is what
// splits the screens and the topic list. Two parallel models would have duplicated
// every one of those, bugs included.
//
// A thread is a RECORD, not a mailbox. The tenant raises it, the owner answers it, and
// the tenant is told by email (and WhatsApp where it is set up) that there is something
// to read. There is no inbound mail ingestion anywhere in this app, which is why EMAIL
// mode says plainly that the conversation moved rather than pretending the thread is
// still live.
// ---------------------------------------------------------------------------

enum SupportKind {
  /// Something is wrong, or I need help using it. Shown as AS-1042.
  SUPPORT
  /// Help me get set up. Shown as OB-1042.
  ONBOARDING
}

enum SupportStatus {
  /// Raised, nobody has answered yet.
  OPEN
  /// The tenant has added something since the last platform reply. Badges.
  AWAITING_US
  /// The platform has replied and is waiting on the tenant.
  AWAITING_TENANT
  /// Answered and agreed done.
  RESOLVED
  /// Closed without a resolution, or closed by the owner.
  CLOSED
  /// Handed to the support inbox by EMAIL mode. The thread stops claiming to be a
  /// conversation and tells the tenant to check their email, because that is where the
  /// answer is actually going to arrive.
  FORWARDED
}

enum SupportAuthorRole {
  TENANT
  PLATFORM
}

model SupportRequest {
  id String @id @default(cuid())

  /// The human reference, rendered AS-1042 / OB-1042 by lib/support/ref.
  ///
  /// A Postgres SEQUENCE, created by hand in the migration, because a count-and-add
  /// would hand two simultaneous tickets the same number and the number is what the
  /// tenant quotes back. Shared across both kinds on purpose: one sequence means one
  /// number can never mean two different threads, and the prefix is what tells a
  /// ticket from an onboarding request.
  number Int @unique @default(dbgenerated("nextval('support_request_number_seq')"))

  kind   SupportKind
  status SupportStatus @default(OPEN)

  /// One of the fixed topics in lib/support/topics (validated on write). Fixed rather
  /// than tenant-authored: the topic is what decides where a request is routed, and a
  /// free-text subject line already exists for everything else.
  topic   String
  subject String

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  /// Who raised it. Nullable and SetNull: a login can be removed while the thread it
  /// opened is still the record of what was asked and answered.
  createdByUserId String?
  createdBy       User?   @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  /// Contact details SNAPSHOTTED when it was raised.
  ///
  /// Not read live from the user row: a reply is answering the person who asked, and
  /// if they changed their email in between, the notification should still reach the
  /// address the conversation started on. Also means a removed login does not take the
  /// thread's only way of reaching anybody with it.
  contactEmail    String
  contactWhatsapp String?

  /// When the tenant last opened the thread. Anything newer than this from the
  /// platform side is what makes the tenant's own badge light up.
  lastSeenByTenantAt DateTime?

  /// When the platform first answered. The one support metric worth keeping, and it
  /// cannot be recovered later from message rows once a thread has several replies.
  firstResponseAt DateTime?

  /// When this was handed to the support inbox by EMAIL mode. Set once: switching the
  /// mode back and forth must not forward the same thread twice.
  forwardedAt DateTime?

  messages    SupportMessage[]
  attachments SupportAttachment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// The owner's queue: this kind, these statuses, newest first.
  @@index([kind, status, createdAt])
  /// The tenant's own list.
  @@index([tenantId, kind, createdAt])
  @@map("support_request")
}

model SupportMessage {
  id        String         @id @default(cuid())
  requestId String
  request   SupportRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  authorRole SupportAuthorRole
  /// Shown in the thread. Snapshotted for the same reason the contacts are.
  authorName String
  authorId   String?
  author     User?             @relation(fields: [authorId], references: [id], onDelete: SetNull)

  body String

  /// The owner's private note. NEVER sent and never rendered on the tenant's side.
  ///
  /// Written through its own action and its own button rather than a checkbox on the
  /// reply box: a reply fires email and WhatsApp the moment it is saved, and there is
  /// no unsend. A note typed into the wrong box with a tick in the wrong state is a
  /// mistake that cannot be taken back, so the two are different buttons.
  isInternal Boolean @default(false)

  /// What the notification actually did. Null = nothing was attempted (an internal
  /// note, or a tenant's own message). SENT / FAILED / SKIPPED otherwise, with the
  /// error kept so the thread can show a Resend button beside the failure instead of
  /// failing silently and waiting to be noticed.
  ///
  /// `webhook*` is the POST to the owner's CRM, which is what turns a reply into a
  /// WhatsApp at their end. Kept per message for the same reason as the email: a
  /// delivery nobody can see the state of is one nobody chases.
  emailStatus   String?
  emailError    String?
  webhookStatus String?
  webhookError  String?

  attachments SupportAttachment[]

  createdAt DateTime @default(now())

  @@index([requestId, createdAt])
  @@map("support_message")
}

model SupportAttachment {
  id        String         @id @default(cuid())
  requestId String
  request   SupportRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  /// The message it came in with. Nullable because an attachment outlives nothing: it
  /// belongs to the request, and the message is only where it was added.
  messageId String?
  message   SupportMessage? @relation(fields: [messageId], references: [id], onDelete: SetNull)

  /// The R2 object key, under the tenant's own prefix. Served only through
  /// /api/support/attachments/[id], which authorises first. Never a bucket URL: a
  /// screenshot of a stuck funnel carries lead names, and a public object URL is
  /// guessable forever.
  key         String
  filename    String
  contentType String
  bytes       Int

  createdAt DateTime @default(now())

  @@index([requestId])
  @@map("support_attachment")
}

/// ---------------------------------------------------------------------------
/// GUIDED SETUP: one row per question answered.
///
/// A new workspace used to read a numbered list of sentences that was the same on
/// every visit and carried no state, so somebody who did three of them on Monday had
/// to remember where they were on Wednesday. This table is that missing memory, and it
/// is deliberately the smallest thing that can carry it.
///
/// 🔴 THE JOURNAL IS NOT THE TRUTH. Every step writes to the place that already owns
/// its value - the pixel to the default ad account, the sender to AppSetting, the
/// colour to Theme - and this row only records that the question was answered. Where
/// the app can check the fact itself, the FACT decides whether the step is done, never
/// the row: a workspace can never look configured with a pixel that does not resolve.
///
/// There is no progress pointer and no completed flag. Position and completion are
/// computed from the step registry plus these rows, so adding, reordering or
/// re-wording a step cannot strand somebody in the middle of their own setup.
///
/// A SECRET IS NEVER STORED HERE. `value` is null for the token steps: the credential
/// goes to its encrypted column and the row says only that it was given, so nothing
/// about this table needs to be redacted on the way to a browser.
model OnboardingAnswer {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  /// The registry key of the step (see src/features/onboarding/steps.ts). A plain
  /// string, not an enum: adding a step must never need a migration.
  stepKey String

  /// What they gave, for the facts that have no other home (the business name, what
  /// they sell). Null for a secret, for a tap-only step, and for a skip.
  value String? @db.Text

  /// They chose to come back to it. Kept apart from an answer so "left to do" can be
  /// listed without guessing at an empty value.
  skipped Boolean @default(false)

  answeredAt DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([tenantId, stepKey])
  @@index([tenantId])
  @@map("onboarding_answer")
}

// ---------------------------------------------------------------------------
// CALENDAR - 1:1 appointment booking.
//
// Four models and no more: what can be booked (BookingType), when it can be booked
// (AvailabilityRule plus AvailabilityException), and what actually got booked
// (Appointment). The automation that fires around an appointment is a separate
// concern and arrives with its own models; the only thing the calendar owes it is an
// event, which it emits through the existing event bus.
// ---------------------------------------------------------------------------

/// Where the call happens. Not free text: the public page has to SAY where to turn up,
/// and three kinds cover it. The detail (a Meet link, a number, an address) lives in
/// locationValue, so adding a kind later never touches the data already there.
enum BookingLocationKind {
  MEET_LINK
  PHONE
  IN_PERSON
}

/// Who put the row in the calendar. A MANUAL row is the owner blocking out their own
/// time: it occupies the slot exactly like a booking, carries no attendee, emits no
/// event and reports nothing to Meta.
enum AppointmentSource {
  BOOKING
  MANUAL
}

/// The life of one appointment. BOOKED is the only live state; the other three are
/// terminal and each is a different thing to tell an ad account.
///
/// ATTENDED and NO_SHOW are the whole reason this feature reports to Meta at all: a
/// booking is an intention, and only the owner marking the outcome afterwards says
/// whether the ad bought a conversation or an empty slot.
enum AppointmentStatus {
  BOOKED
  CANCELLED
  ATTENDED
  NO_SHOW
}

/// A named exception to the weekly pattern, in both directions: BLOCK takes time away
/// (a holiday, a half day), OPEN adds a window on a date the weekly rules do not cover
/// (a Sunday opened for one week only).
enum AvailabilityExceptionKind {
  BLOCK
  OPEN
}

/// One thing that can be booked, e.g. "30-minute strategy call". Publicly reachable at
/// /b/<slug> while active.
///
/// The slug is GLOBALLY unique, matching Assessment: the public page is resolved by
/// slug alone, so per-tenant uniqueness would make /b/discovery-call ambiguous the
/// moment a second workspace picked the same name.
model BookingType {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name        String
  slug        String  @unique
  description String? @db.Text

  /// Minutes. duration is the call; buffer is dead time AFTER it that no other booking
  /// may take, so back-to-back calls cannot be booked against a stated gap.
  durationMin Int @default(30)
  bufferMin   Int @default(0)

  /// Shortest notice a respondent may book at (minutes). Without it an ad clicked at
  /// 11:58 can book the 12:00 slot, and the owner finds out when the call starts.
  noticeMin Int @default(120)

  /// How far ahead the public page offers dates.
  horizonDays Int @default(30)

  /// Slot start granularity in minutes. 0 means duration + buffer, which is the
  /// everyday case (a 30-minute call offered on the half hour). Setting it smaller
  /// offers overlapping starts, which some owners want for a short call.
  slotStepMin Int @default(0)

  /// Cap on live bookings per IST day. Null = no cap. A day at its cap offers no slots
  /// rather than hiding the booking type, so the respondent is told to pick another day.
  maxPerDay Int?

  locationKind BookingLocationKind @default(MEET_LINK)

  /// The meeting link, phone number or address. Shown on the confirmation and in the
  /// calendar feed, never on the slot picker.
  locationValue String?

  active Boolean @default(true)

  /// The funnel this call belongs to, when it has one. Two jobs: it is how a booking
  /// made from a result page is attributed back to the assessment that produced it, and
  /// it is where the funnel event counters are kept.
  assessmentId String?
  assessment   Assessment? @relation(fields: [assessmentId], references: [id], onDelete: SetNull)

  /// Which ad account the appointment events report to. Null = the tenant's default,
  /// the same contract as Assessment.adAccountId. Restrict, so deleting an ad account
  /// that a live booking type reports to fails loudly instead of silently re-pointing
  /// its conversions at another pixel.
  adAccountId String?
  adAccount   AdAccount? @relation(fields: [adAccountId], references: [id], onDelete: Restrict)

  /// WHOSE time this link sells.
  ///
  /// One link per staff member: the hours on it are that person's hours, the slots it
  /// offers are free in that person's diary, and a lead who opens it books that person.
  /// There is no pooling or round-robin - a slot belongs to one calendar.
  ///
  /// Null is the workspace's own shared calendar, which is what every link created
  /// before staff calendars existed is, and what a one-person workspace keeps using
  /// without ever meeting the idea of an assignee.
  ///
  /// SetNull rather than Restrict because a staff member is soft-deleted here (the row
  /// stays), so Restrict would never fire and would only be a promise the database
  /// cannot keep. An unassigned link is visibly unassigned on the availability screen.
  assignedUserId String?
  assignedUser   User?   @relation("StaffBookingTypes", fields: [assignedUserId], references: [id], onDelete: SetNull)

  /// Master switch for the Meta side of this booking type. Off means the calendar still
  /// works and the webhooks still fire, and nothing reaches the ad account.
  fireMetaCapi Boolean @default(true)

  /// The Meta event name per moment, configurable because an ad account's history is
  /// its own. The default for a booking is the STANDARD event Schedule, which Meta can
  /// optimize delivery for; the other three have no standard equivalent, so they are
  /// custom events and are useful as audiences rather than as optimization targets.
  metaBookedEvent    String @default("Schedule")
  metaCancelledEvent String @default("AppointmentCancelled")
  metaAttendedEvent  String @default("AppointmentAttended")
  metaNoShowEvent    String @default("AppointmentNoShow")

  rules        AvailabilityRule[]
  exceptions   AvailabilityException[]
  appointments Appointment[]
  automations  Automation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([assessmentId])
  @@map("booking_type")
}

/// One recurring weekly window, e.g. Tuesdays 10:00 to 13:00.
///
/// Minutes from midnight IST rather than a time column: slot arithmetic is integer
/// arithmetic on a fixed offset (see src/lib/calendar/slots.ts), and a time-of-day
/// column would hand the same job to the runtime's timezone, which on Railway is UTC.
model AvailabilityRule {
  id            String      @id @default(cuid())
  bookingTypeId String
  bookingType   BookingType @relation(fields: [bookingTypeId], references: [id], onDelete: Cascade)

  /// 0 = Sunday through 6 = Saturday, IST.
  weekday  Int
  startMin Int
  endMin   Int

  createdAt DateTime @default(now())

  @@index([bookingTypeId])
  @@map("availability_rule")
}

/// A one-date change to the weekly pattern. A BLOCK with no times is the whole day off.
model AvailabilityException {
  id            String      @id @default(cuid())
  bookingTypeId String
  bookingType   BookingType @relation(fields: [bookingTypeId], references: [id], onDelete: Cascade)

  /// The IST calendar date this applies to, stored as a plain date so it cannot drift
  /// across midnight when read on a UTC host.
  date DateTime @db.Date

  kind     AvailabilityExceptionKind @default(BLOCK)
  startMin Int?
  endMin   Int?
  note     String?

  createdAt DateTime @default(now())

  @@index([bookingTypeId, date])
  @@map("availability_exception")
}

/// One row in the calendar: a booked call, or time the owner blocked out.
model Appointment {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  /// Null for a manual block, and SetNull rather than Cascade for a booking: deleting a
  /// booking type must not erase the history of calls that were sold through it.
  bookingTypeId String?
  bookingType   BookingType? @relation(fields: [bookingTypeId], references: [id], onDelete: SetNull)

  source AppointmentSource @default(BOOKING)
  status AppointmentStatus @default(BOOKED)

  /// Stored UTC, always. Every surface renders DD-MM-YYYY HH:MM IST through formatIST.
  startAt DateTime
  endAt   DateTime

  title String?
  notes String? @db.Text

  attendeeName   String?
  attendeeEmail  String?
  attendeeMobile String?

  /// The submission this call came out of, when it was booked from a result page. The
  /// link is what makes the appointment part of the funnel rather than a diary entry.
  /// SetNull: a deleted submission must not take the appointment with it.
  submissionId String?
  submission   Submission? @relation(fields: [submissionId], references: [id], onDelete: SetNull)

  /// WHICH calendar this sits in: the staff member the booking link belongs to, or null
  /// for the workspace's shared one. Stamped at booking time from the link rather than
  /// read through it, because the link can be reassigned later and a past appointment
  /// belongs to the diary it was actually in.
  ///
  /// It is also half of the double-booking key (see slotLock): two staff members can
  /// each take 11:00, and one of them cannot take it twice.
  assignedUserId String?
  assignedUser   User?   @relation("StaffAppointments", fields: [assignedUserId], references: [id], onDelete: SetNull)

  /// Meta match signals, snapshotted at booking time.
  ///
  /// 🔴 This is what makes the offline fire work. ATTENDED is marked days after the
  /// browser that booked the call has gone, so there is no request to read _fbp / _fbc
  /// from at that point. Captured here, an attendance marked on Friday still matches
  /// the ad clicked on Monday; captured at fire time, it would match nothing.
  fbp         String?
  fbc         String?
  externalId  String?
  clientIp    String?
  userAgent   String?
  attribution Json?

  /// Booked during an owner's own preview run. Everything about the row is real; the
  /// server-side conversion is the one thing it must not produce.
  isPreview Boolean @default(false)

  /// The double-booking guard.
  ///
  /// Holds "tenantId:startAt" while the row is live and is set to NULL the moment it is
  /// cancelled. Postgres treats NULLs as distinct in a unique index, so a cancelled slot
  /// frees itself for the next person while two simultaneous bookings of the same slot
  /// cannot both commit. A partial unique index would say the same thing, and Prisma
  /// cannot express one.
  ///
  /// Keyed on the WORKSPACE rather than the booking type, because there is one calendar
  /// per workspace: two people booking different call types for the same 11:00 are
  /// booking the same hour of the same person. See slotLockFor in lib/calendar/slots.ts
  /// for what this still cannot catch.
  slotLock String? @unique

  /// Capability token in the respondent's own links: the .ics download now, and the
  /// cancel / reschedule page when it ships. Random per appointment, so one person's
  /// link never reaches another's booking.
  publicToken String @unique

  /// Per-moment "already reported" stamps: the event bus emit AND the Meta conversion
  /// for that moment happen together, once, however many times an operator presses the
  /// button or a retry runs. RESCHEDULED has no stamp on purpose: moving a call twice is
  /// two things the CRM needs to hear, not a duplicate.
  reportedBookedAt    DateTime?
  reportedCancelledAt DateTime?
  reportedAttendedAt  DateTime?
  reportedNoShowAt    DateTime?

  /// Set on the NEW row when a booking is moved, pointing at the row it replaced.
  rescheduledFromId String?

  cancelledAt DateTime?

  /// "operator" or "respondent". Who ended it changes what you say to them next.
  cancelledBy        String?
  attendanceMarkedAt DateTime?

  /// Google Calendar two-way sync, which arrives with its own phase. The columns are
  /// here from the start so that landing it is a code change rather than a migration
  /// against a table that by then holds live bookings.
  googleEventId   String?
  googleSyncedAt  DateTime?
  googleSyncError String?

  /// Queued automation firings for this appointment (reminders and the rest).
  automationRuns AutomationRun[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, startAt])
  @@index([bookingTypeId, startAt])
  @@index([submissionId])
  @@index([status, startAt])
  @@map("appointment")
}

/// A workspace's connected Google Calendar.
///
/// 🟡 NO READER YET, deliberately. The OAuth connect and disconnect pair ships in its
/// own phase; the model is in the first migration so that phase adds routes and a
/// button rather than a schema change. Nothing in the app shows a Google card until it
/// can actually connect, because a button that does nothing is worse than no button.
///
/// One per workspace (tenantId unique), matching the single shared calendar that ships
/// first. Tokens are encrypted at rest like every other secret here, and disconnecting
/// deletes the row outright rather than blanking it, so revoking leaves nothing behind.
model GoogleCalendarAccount {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  /// WHICH CALENDAR this connection belongs to: a staff member's own, or the
  /// workspace's shared one.
  ///
  /// 🔴 calendarKey is NOT NULL and carries the literal "shared" for the workspace
  /// calendar, because the unique index is the only thing stopping one calendar being
  /// connected to two Google accounts - and Postgres treats NULLs as DISTINCT, so
  /// @@unique([tenantId, userId]) with a null userId would happily allow a second row.
  /// The same trap as Appointment.slotLock, solved the same way.
  calendarKey String
  /// The staff member, for showing whose connection it is. Null for the shared
  /// calendar. Cascade: a hard-deleted user takes their own connection with them.
  userId      String?
  user        User?   @relation("StaffGoogleCalendars", fields: [userId], references: [id], onDelete: Cascade)

  /// Which Google account and calendar this is, for showing what is connected.
  googleEmail String?
  /// The Google calendar to write to. "primary" is the owner's own calendar and is the
  /// only one offered for now; the column exists so picking another is a UI change.
  calendarId  String? @default("primary")

  accessTokenEnc  String?
  refreshTokenEnc String?
  expiresAt       DateTime?
  scope           String?

  /// Connected but paused. Kept apart from deleting the row so a workspace can stop
  /// writing to Google without re-doing the OAuth dance to start again.
  syncEnabled Boolean @default(true)

  connectedAt DateTime  @default(now())
  lastSyncAt  DateTime?
  lastError   String?

  updatedAt DateTime @updatedAt

  @@unique([tenantId, calendarKey])
  @@index([tenantId])
  @@map("google_calendar_account")
}

// ---------------------------------------------------------------------------
// AUTOMATION - trigger, then actions.
//
// One shape, three models: an Automation is a trigger plus a list of actions, and an
// AutomationRun is one firing of it for one appointment. Nothing here knows how to send
// anything: the actions carry an email or an approved WhatsApp template and the sending
// is the nurture sender, which already holds the SMTP and Cloud API plumbing, the
// placeholder substitution and the send log.
//
// 🟡 Triggers are APPOINTMENT ONLY for now, on purpose. The opt-in and completion events
// already have a sender (Nurture), and offering them here as well would be two screens
// that both send one email on opt-in, disagreeing about which. The trigger enum and the
// event-bus hook are shaped so that adding them later is a registry entry, not a design.
// ---------------------------------------------------------------------------

/// What starts an automation.
///
/// Five of these are events that have already happened; APPOINTMENT_REMINDER is the odd
/// one and the reason the run queue exists, because it is due at a time relative to a
/// call that has not happened yet.
enum AutomationTrigger {
  APPOINTMENT_BOOKED
  APPOINTMENT_RESCHEDULED
  APPOINTMENT_CANCELLED
  APPOINTMENT_ATTENDED
  APPOINTMENT_NO_SHOW
  APPOINTMENT_REMINDER
}

/// How an action reaches the person. Both go through the nurture sender.
enum AutomationChannel {
  EMAIL
  WABA
}

/// The life of one queued firing.
///
/// SKIPPED is not a failure and is kept apart from one: a reminder for a call that was
/// cancelled yesterday must not be sent, and the owner needs to see that it was
/// deliberately not sent rather than that it broke.
enum AutomationRunStatus {
  PENDING
  SENDING
  SENT
  FAILED
  SKIPPED
  CANCELLED
}

/// One rule: when THIS happens, do THESE things.
model Automation {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name    String
  trigger AutomationTrigger

  /// Which booking link this watches. NULL means every one in the workspace, which is
  /// what most owners want for a reminder and what a second booking link would
  /// otherwise silently miss.
  bookingTypeId String?
  bookingType   BookingType? @relation(fields: [bookingTypeId], references: [id], onDelete: Cascade)

  /// Minutes relative to the call's START, for APPOINTMENT_REMINDER only. Negative is
  /// before (-1440 = a day ahead), positive is after. Ignored by every other trigger,
  /// which fire when their event does.
  offsetMin Int @default(-1440)

  /// Switched off keeps the rule and stops the sending. Pending runs are left alone:
  /// the worker re-reads the automation when a run comes due, so switching off stops
  /// tomorrow's reminders without having to go and find them.
  active Boolean @default(true)

  actions AutomationAction[]
  runs    AutomationRun[]
  sends   AutomationSend[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([trigger, active])
  @@map("automation")
}

/// One thing an automation does. Ordered, and they run in order.
///
/// The two channels keep their own columns rather than sharing a JSON blob: an email is
/// a subject and a body, a WhatsApp message is an approved template name plus the
/// variables to fill its numbered slots, and the two have nothing in common but the
/// person they reach.
model AutomationAction {
  id           String     @id @default(cuid())
  automationId String
  automation   Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)

  displayOrder Int               @default(0)
  channel      AutomationChannel

  /// EMAIL. Both accept {{placeholders}} - the lead's fields plus the appointment's.
  subject String?
  body    String? @db.Text

  /// WABA. The template must be APPROVED on the workspace's own WhatsApp Business
  /// Account; business-initiated messages cannot be free text, which is why there is a
  /// name here and not a message.
  wabaTemplate String?
  wabaLang     String  @default("en")
  /// Ordered values for the template's {{1}}, {{2}} … Each is literal text or a
  /// placeholder, resolved at send time.
  wabaVars     Json?

  /// LIFETIME tallies for this one message, so the builder can say what it has
  /// actually done. Counters rather than a COUNT over the log, because the log keeps
  /// 30 days and "sent 4 in the last month" is a different question from "sent 1,482
  /// since you wrote it" - the page shows both and they are both true.
  sentCount    Int @default(0)
  failedCount  Int @default(0)
  skippedCount Int @default(0)
  /// First clicks on a link in this email, credited by the click redirect (/e/c).
  /// Zero forever for WhatsApp, which has no click tracking of ours.
  clickCount   Int @default(0)

  sends AutomationSend[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([automationId, displayOrder])
  @@map("automation_action")
}

/// One firing of one automation for one appointment: the durable queue AND the log.
///
/// 🔴 Why a row rather than a timer. A reminder is due hours or days after the thing
/// that scheduled it, and an in-process timer dies with the deploy that created it -
/// silently, with nobody to tell. A row survives deploys, restarts and the worker
/// falling over, and the cron picks up whatever is due. The same reasoning as the
/// webhook delivery queue.
model AutomationRun {
  id           String     @id @default(cuid())
  automationId String
  automation   Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)

  appointmentId String
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  /// Denormalized so the log can be scoped and read without a join.
  tenantId String

  /// When this should go out. Now, for the five event triggers; start plus the offset
  /// for a reminder. Also the retry time after a failure.
  dueAt DateTime

  status     AutomationRunStatus @default(PENDING)
  attempts   Int                 @default(0)
  lastError  String?
  firedAt    DateTime?
  /// Why it was skipped, in the owner's words ("the call was cancelled").
  skipReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// ONE row per automation per appointment, forever. A re-emitted event updates this
  /// row instead of stacking a second reminder, and a rescheduled call moves its due
  /// time rather than sending twice.
  @@unique([automationId, appointmentId])
  @@index([status, dueAt])
  @@index([tenantId, createdAt])
  @@map("automation_run")
}

/// AI spend, per call, attributed to a tenant.
///
/// 🔴 ONLY WHAT WE PAY FOR. A row is written when the call ran on the PLATFORM's
/// provider key, because that is the only usage that costs this business money. A
/// tenant running on their own key spends their own money, and counting it as our
/// expense would make every Accounts figure wrong in the same direction.
/// `onPlatformKey` is stored anyway rather than filtering at write time: knowing a
/// tenant generates heavily on their own key is useful, and a column is cheaper than
/// discovering later that the rows were never kept.
///
/// Written at the single AI call site (lib/ai/generate.ts), after the provider
/// answers, and never in a way that can fail the generation it is measuring.
model AiUsage {
  id String @id @default(cuid())

  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  /// "openai" | "anthropic" | "gemini", and the model string the provider was asked for.
  provider String
  model    String
  /// What it was generating, for reading the bill later: "statement" | "report" | "questions".
  purpose  String?

  /// Whose key paid. False = the tenant's own key, so NOT our expense.
  onPlatformKey Boolean @default(true)

  inputTokens  Int @default(0)
  outputTokens Int @default(0)

  /// Cost in micro-dollars (USD x 1,000,000). An integer because a per-call cost is
  /// frequently a fraction of a cent, and float money that gets summed across
  /// thousands of rows drifts. Divide by 1e6 to display.
  costMicroUsd Int @default(0)

  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([createdAt])
  @@map("ai_usage")
}

/// One attempt to deliver one message of one automation, kept for 30 days.
///
/// 🔴 KEYED ON THE ACTION, which is why saving an automation no longer deletes and
/// recreates its actions. An action's id IS the identity of that message: "the reminder
/// email" has to keep its numbers when its wording is edited, or every stat on the page
/// resets the first time somebody fixes a typo.
///
/// The row is pruned after 30 days; the lifetime counters on the action are not, so the
/// page can say both "sent 1,482 of these" and "here are the last 30 days".
model AutomationSend {
  id       String @id @default(cuid())
  tenantId String

  automationId String
  automation   Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)

  actionId String
  action   AutomationAction @relation(fields: [actionId], references: [id], onDelete: Cascade)

  /// The firing this belonged to. A plain reference, no FK: runs are pruned on their
  /// own schedule and a send must not disappear with one.
  runId String?

  channel AutomationChannel
  status  AutomationSendStatus

  /// Where it went: an email address or E.164 digits. Kept so a bounce can be traced
  /// to the address it was actually sent to rather than to whatever the lead holds now.
  toAddress String?
  error     String?

  /// The NurtureLog row this email became, so a click on it (NurtureLog.clickedAt) is
  /// attributable back to the message that earned it. Null for WhatsApp, which has no
  /// click tracking of ours.
  nurtureLogId String?

  createdAt DateTime @default(now())

  @@index([actionId, createdAt])
  @@index([tenantId, createdAt])
  /// The retention sweep's index: delete where createdAt < 30 days ago.
  @@index([createdAt])
  @@map("automation_send")
}

enum AutomationSendStatus {
  SENT
  FAILED
  SKIPPED
}

// ---------------------------------------------------------------------------
// CONTACT - one row per person, which this schema has never had.
//
// A lead's name, email and mobile are copied onto Submission AND GateEntry, once per
// run. That is right for those tables: a submission is a snapshot of what somebody
// typed that day, and it must not change when they later type something else. But it
// means the product has no idea that four submissions and a gate entry are one human,
// and everything the owner now wants - tags, a do-not-disturb flag, an audience to
// broadcast to, an unsubscribe that actually stops the messages - is a statement about
// the human rather than about any one run.
//
// So the run tables keep their columns exactly as they are, and gain a nullable link
// to the person. Nothing that works today starts depending on this table: the contact
// is upserted ALONGSIDE the lead write, outside its transaction, and a failure there
// loses a tag, never a lead.
model Contact {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  /// E.164 DIGITS, no plus, normalised by toE164Digits - the same function the WhatsApp
  /// sender uses, so a number that can be messaged and a number that can be matched are
  /// the same string. The primary identity: a mobile is what WhatsApp needs.
  mobile String?
  email  String?

  firstName  String?
  lastName   String?
  profession String?

  /// CONSENT, as it was actually shown. The text is stored, not just the timestamp,
  /// because "they agreed" is worth nothing a year later without "to what".
  consentAt   DateTime?
  consentText String?   @db.Text

  /// DO NOT DISTURB. Set, and no marketing message of any kind goes out, on any
  /// channel, from any workflow or broadcast. One flag, checked at one choke point.
  marketingOptOutAt DateTime?
  /// How they left: "LINK" (the unsubscribe page), "WHATSAPP_STOP" (they replied STOP
  /// or tapped the opt-out button), "ADMIN" (somebody did it for them).
  optOutSource      String?

  /// Capability token in the unsubscribe URL. Unguessable, because the page it opens
  /// takes an irreversible action with no login.
  optOutToken String @unique

  /// Where the person first came from: "SUBMISSION" | "SPLIT_GATE" | "ADMIN".
  source     String?
  lastSeenAt DateTime @default(now())

  tags         ContactTag[]
  workflowRuns WorkflowRun[]
  submissions  Submission[]
  gateEntries  GateEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Two partial identities rather than one composite. Postgres treats NULLs as
  /// distinct, so the email-only contacts a SPLIT gate produces do not collide with
  /// each other, and neither do the mobile-only ones.
  @@unique([tenantId, mobile])
  @@unique([tenantId, email])
  @@index([tenantId, createdAt])
  @@index([tenantId, marketingOptOutAt])
  @@map("contact")
}

/// A label the workspace invents. Named per tenant, so two workspaces can both have
/// "hot" and mean different things.
model Tag {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name  String
  /// A token name from the palette, for the chip. Null renders the neutral chip.
  color String?

  contacts ContactTag[]

  createdAt DateTime @default(now())

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("tag")
}

/// Which contacts carry which tag. A join row rather than a string array, because the
/// audience filter asks "every contact with this tag" far more often than it asks
/// "every tag on this contact", and only one of those is an index.
model ContactTag {
  contactId String
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  tagId     String
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  /// When it was applied, so a workflow can ask "tagged in the last 7 days".
  createdAt DateTime @default(now())

  @@id([contactId, tagId])
  @@index([tagId])
  @@map("contact_tag")
}

/// One provider, one day, what it ACTUALLY cost.
///
/// 🔴 THE PRICE IS NEVER STORED. A rate table is a copy of a price list that changes
/// without telling us, and the moment the app holds one it begins telling a second
/// story that drifts from the invoice and compounds. So this holds the money the
/// provider billed, and the tokens it billed it for, and every per-tenant figure is a
/// share of that. Rates stale, shares do not.
///
/// THE RECONCILIATION. `ourMicroUsd` (billed x scopeTokens / totalTokens) is this
/// product's real cost for the day. The Accounts page splits exactly that across
/// tenants by their recorded tokens and shows whatever will not attribute as
/// UNATTRIBUTED, so billed always equals attributed plus unattributed. There is no
/// residue left anywhere to grow quietly into a different number.
model AiCostDay {
  id String @id @default(cuid())

  /// "claude" | "openai" | "gemini", matching AiUsage.provider.
  provider String
  /// The UTC day the provider billed. Theirs, not IST: reconciling against an invoice
  /// means using the invoice's own day boundary.
  day      DateTime @db.Date

  /// Real spend for the billed scope that day, in micro-dollars (USD x 1,000,000).
  billedMicroUsd Int @default(0)

  /// Tokens on OUR api key that day, from the provider's usage report.
  scopeTokens Int @default(0)
  /// Tokens across the whole billed scope that day. Equal to scopeTokens on a
  /// dedicated account; larger when the organisation is shared with another product.
  totalTokens Int @default(0)

  /// "cost_report" when the money came from the provider, "estimate" when no such
  /// endpoint exists (Gemini) and it was priced from a table. Shown on the page, so
  /// an estimate is never read as an invoice.
  source String  @default("cost_report")
  /// Why a day is missing or partial, in words, for the page to show.
  note   String?

  fetchedAt DateTime @default(now())

  @@unique([provider, day])
  @@index([day])
  @@map("ai_cost_day")
}

// ---------------------------------------------------------------------------
// WORKFLOWS - a sequence of messages sent to a PERSON, over time.
//
// Deliberately NOT the Automation model, and the duplication is on purpose for now.
// Automation is an appointment engine: its run row is welded to an appointmentId, one
// rule fires at one moment, and every action in it goes out together. A workflow needs
// a subject that is a person, a delay BETWEEN steps, and a draft state - which is a
// different model, not a bigger one. Unifying them would mean an invasive migration on
// a table another workstream is actively writing to, so the two engines share the
// parts that matter (lib/nurture/send.ts for sending, lib/contacts/dnd.ts for
// suppression) and keep their own queues. Merging them is a deliberate refactor for
// whoever finishes last, not something to do while both are being built.
enum WorkflowTrigger {
  CONTACT_OPTED_IN
  ASSESSMENT_COMPLETED
  GATE_QUALIFIED
  BAND_REACHED
  TAG_ADDED
}

/// DRAFT is the shipping state of a new workflow, and the reason this is an enum
/// rather than the active boolean the automations use: "never published" and
/// "published then switched off" look identical to a boolean, and only one of them is
/// safe to edit without warning anybody.
enum WorkflowStatus {
  DRAFT
  PUBLISHED
  PAUSED
}

enum WorkflowStepKind {
  MESSAGE
  DELAY
  TAG
}

enum WorkflowChannel {
  EMAIL
  WABA
}

/// Months are CALENDAR months, which is why the unit is stored rather than flattened
/// into minutes when it is typed. "One month after they opted in" means the same date
/// next month, not 43,200 minutes later, and the two drift apart by up to three days.
enum WorkflowDelayUnit {
  MINUTES
  HOURS
  DAYS
  MONTHS
}

enum WorkflowTagAction {
  ADD
  REMOVE
}

enum WorkflowRunStatus {
  PENDING
  SENDING
  DONE
  FAILED
  CANCELLED
}

model Workflow {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name    String
  trigger WorkflowTrigger
  status  WorkflowStatus  @default(DRAFT)

  /// Which funnel this watches. Null means every one in the workspace.
  ///
  /// A plain id and NOT a foreign key, on purpose. A relation would force a choice
  /// between cascade-deleting a workflow when somebody deletes a funnel, and setting
  /// this to null - which silently WIDENS the audience from one assessment to all of
  /// them. Neither is acceptable, and the plain id gives the safe third behaviour for
  /// free: events only ever arrive carrying a live assessment id, so a workflow
  /// pointing at a deleted one simply never matches again.
  assessmentId String?

  /// For BAND_REACHED: which band. Null on every other trigger.
  bandKey String?

  /// For TAG_ADDED: which tag. A plain id for the same reason as assessmentId - a
  /// deleted tag should quieten the workflow, never delete it.
  triggerTagId String?

  steps WorkflowStep[]
  runs  WorkflowRun[]
  sends WorkflowSend[]

  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([tenantId])
  @@index([trigger, status])
  @@map("workflow")
}

/// One step. Ordered, and the order IS the sequence.
model WorkflowStep {
  id         String   @id @default(cuid())
  workflowId String
  workflow   Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  displayOrder Int              @default(0)
  kind         WorkflowStepKind

  /// MESSAGE
  channel      WorkflowChannel?
  subject      String?
  body         String?          @db.Text
  /// WABA: a business-initiated message cannot be free text, so this is an approved
  /// template name plus the ordered values for its numbered slots.
  wabaTemplate String?
  wabaLang     String           @default("en")
  wabaVars     Json?

  /// DELAY: how long to wait BEFORE this step. Amount plus unit, never normalised.
  delayAmount Int?
  delayUnit   WorkflowDelayUnit?

  /// TAG: a plain tag id, and what to do with it.
  tagId     String?
  tagAction WorkflowTagAction?

  /// LIFETIME tallies for this one step. Counters rather than a COUNT over the log,
  /// because the log is pruned and "sent 1,482 since you wrote it" is a different
  /// question from "sent 4 this month" - the page shows both and both are true.
  sentCount    Int @default(0)
  failedCount  Int @default(0)
  skippedCount Int @default(0)

  sends WorkflowSend[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workflowId, displayOrder])
  @@map("workflow_step")
}

/// One person going through one workflow: the durable queue AND the log.
///
/// A row rather than a timer, for the same reason the automations use one: a step due
/// in three days outlives any in-process timer, and a timer dies with the deploy that
/// created it, silently, with nobody to tell.
model WorkflowRun {
  id         String   @id @default(cuid())
  workflowId String
  workflow   Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  contactId String
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  /// Denormalised so the log reads without a join, exactly like automation_run.
  tenantId String

  /// What started it, for the placeholders a message can use. A submission id today;
  /// a plain id so a later trigger can point at something else.
  subjectId String?

  /// displayOrder of the NEXT step to run. A sequence advances by moving this.
  currentStep Int @default(0)

  /// When that step is due. Now for an immediate one, the delay out for a waited one.
  dueAt DateTime

  status     WorkflowRunStatus @default(PENDING)
  attempts   Int               @default(0)
  lastError  String?
  /// Why it stopped early, in the owner words ("they unsubscribed").
  stopReason String?

  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  updatedAt  DateTime  @updatedAt

  /// ONE run per person per workflow, forever. A second opt-in moves nothing and
  /// queues nothing: somebody three days into a sequence must not be put back at the
  /// start by filling the form again.
  @@unique([workflowId, contactId])
  @@index([status, dueAt])
  @@index([tenantId, startedAt])
  @@map("workflow_run")
}

/// One attempt to deliver one step, kept for 30 days. Keyed on the STEP, so editing a
/// step wording does not reset what it has done.
model WorkflowSend {
  id       String @id @default(cuid())
  tenantId String

  workflowId String
  workflow   Workflow     @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  stepId     String
  step       WorkflowStep @relation(fields: [stepId], references: [id], onDelete: Cascade)

  contactId String?
  channel   WorkflowChannel
  /// "SENT" | "FAILED" | "SKIPPED"
  status    String
  toAddress String?
  error     String?

  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([stepId])
  @@map("workflow_send")
}

/// ---------------------------------------------------------------------------
///  ONE SWITCH PER FEATURE, FOR EVERY WORKSPACE AT ONCE.
/// ---------------------------------------------------------------------------
///
/// The problem this solves is not "who may use what" - the plan catalog already
/// answers that. It is RELEASE: code lands in production finished but unproven, the
/// owner exercises it on their own internal workspace, and only then do customers get
/// to see it. Without a switch the only way to hold a feature back is to hold the
/// BRANCH back, and a long-lived branch is how a release breaks three features that
/// had nothing to do with it.
///
/// So the row is the release, not the entitlement. `released = false` means every
/// customer workspace behaves exactly as it did before the feature existed: the menu
/// item is absent, the route redirects, the actions refuse and the senders skip. The
/// owner's own scope (the platform, and any INTERNAL tenant - Tenant.unlimited) is
/// exempt and always sees it, which is what makes "test it as a tenant would" possible
/// at all.
///
/// REVERSIBLE BY DESIGN. Switching a key back off is a kill switch, not a deletion:
/// every row a tenant created stays exactly where it is, unread, and switching back on
/// restores what was there. That is the whole reason this is a flag and not a revert.
///
/// A key with NO ROW falls back to the default in lib/features/catalog.ts. That
/// fallback is also what a failed read uses, and it is chosen per feature so a database
/// blip can only ever hold a feature in its safe state: already-released features stay
/// up (default true), unreleased ones stay hidden (default false).
model FeatureRelease {
  /// The catalog key (lib/features/catalog.ts). A plain string primary key, not an
  /// enum: adding a feature should be a code constant plus a seed row, never a
  /// migration that rewrites a type while the app is running.
  key String @id

  released Boolean @default(false)

  /// When it was last switched ON. Left in place when it is switched off again, so the
  /// row still answers "when did customers first get this" after a kill switch.
  releasedAt DateTime?

  /// Who flipped it, and why. A plain user id rather than a relation: the audit should
  /// survive the staff account that made the change being deleted.
  changedByUserId String?
  note            String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("feature_release")
}
