---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Problem from '../components/Problem.astro';
import HowItWorks from '../components/HowItWorks.astro';
import Capabilities from '../components/Capabilities.astro';
import UseCases from '../components/UseCases.astro';
import Pricing from '../components/Pricing.astro';
import Faq from '../components/Faq.astro';
import FinalCta from '../components/FinalCta.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../config';
---

<Base>
  <Nav />
  <main id="main">
    <Hero />
    <Problem />
    <HowItWorks />
    <Capabilities />
    <UseCases />
    <Pricing />
    <Faq />
    <FinalCta />
  </main>
  <Footer />

  {SITE.webhookUrl && (
    <script is:inline define:vars={{ webhookUrl: SITE.webhookUrl, signupUrl: SITE.signupUrl }}>
      // Optional: fire a non-blocking ping to your n8n webhook when a CTA is clicked.
      // Navigation is never delayed or blocked by this.
      document.addEventListener('click', function (e) {
        var a = e.target instanceof Element ? e.target.closest('a[href^="' + signupUrl + '"]') : null;
        if (!a) return;
        try {
          var payload = JSON.stringify({
            event: 'cta_click',
            label: (a.textContent || '').trim(),
            path: location.pathname,
            ts: new Date().toISOString(),
          });
          if (navigator.sendBeacon) {
            navigator.sendBeacon(webhookUrl, new Blob([payload], { type: 'application/json' }));
          } else {
            fetch(webhookUrl, { method: 'POST', body: payload, keepalive: true, headers: { 'Content-Type': 'application/json' } });
          }
        } catch (err) {
          /* never block navigation */
        }
      });
    </script>
  )}
</Base>
