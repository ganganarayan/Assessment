---
const steps = [
  {
    n: '01',
    title: 'Build the scorecard',
    body: 'Define your dimensions, weight what matters, and set the score that means "qualified."',
  },
  {
    n: '02',
    title: 'Share the link',
    body: 'Send one hosted link — in email, ads, or on your site. No embed, no re-hosting.',
  },
  {
    n: '03',
    title: 'Score & route the leads',
    body: 'Every response is scored instantly and routed by fit, so sales sees the ready ones first.',
  },
];
---

<section id="how" class="scroll-mt-20 border-b border-slate-200/70">
  <div class="mx-auto max-w-content px-5 py-20 sm:px-8">
    <div class="max-w-2xl">
      <h2 class="font-display text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">
        How it works
      </h2>
      <p class="mt-4 text-lg text-slate-600">Three steps from a link to a scored, routed lead.</p>
    </div>

    <ol class="mt-12 grid gap-8 md:grid-cols-3">
      {steps.map((s) => (
        <li class="rounded-xl border border-slate-200 bg-white p-7">
          <span class="font-display text-sm font-bold text-accent">{s.n}</span>
          <h3 class="mt-3 font-display text-lg font-semibold text-slate-900">{s.title}</h3>
          <p class="mt-2 leading-relaxed text-slate-600">{s.body}</p>
        </li>
      ))}
    </ol>
  </div>
</section>
