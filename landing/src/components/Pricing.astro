---
import { SITE, TIERS, FOUNDING_NOTE } from '../config';
---

<section id="pricing" class="scroll-mt-20 border-b border-slate-200/70 bg-slate-50/60">
  <div class="mx-auto max-w-content px-5 py-20 sm:px-8">
    <div class="max-w-2xl">
      <h2 class="font-display text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">
        Pricing that scales with volume, not features
      </h2>
      <p class="mt-4 text-lg text-slate-600">
        The builder stays generous at every tier. You pay as your responses, seats, and
        sub-accounts grow. Prices in USD.
      </p>
    </div>

    <div class="mt-12 grid gap-6 lg:grid-cols-4">
      {TIERS.map((tier) => (
        <div
          class={`flex flex-col rounded-2xl border bg-white p-7 ${
            tier.highlight ? 'border-accent shadow-lg shadow-accent/10 ring-1 ring-accent' : 'border-slate-200'
          }`}
        >
          {tier.badge && (
            <span class="mb-4 inline-flex w-fit items-center rounded-full bg-accent px-3 py-1 text-xs font-semibold text-white">
              {tier.badge}
            </span>
          )}
          <h3 class="font-display text-lg font-semibold text-slate-900">{tier.name}</h3>
          <div class="mt-3 flex items-baseline gap-1">
            <span class="font-display text-4xl font-bold tracking-tight text-slate-900">{tier.price}</span>
            <span class="text-sm text-slate-500">{tier.period}</span>
          </div>
          <p class="mt-3 min-h-[3rem] text-sm leading-relaxed text-slate-600">{tier.blurb}</p>

          <a
            href={SITE.signupUrl}
            class={`mt-5 inline-flex items-center justify-center rounded-lg px-4 py-2.5 text-sm font-semibold transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent ${
              tier.highlight
                ? 'bg-accent text-white hover:bg-accent-hover'
                : 'border border-slate-300 text-slate-700 hover:border-slate-400 hover:text-slate-900'
            }`}
          >
            {tier.cta}
          </a>

          <ul class="mt-6 space-y-3 border-t border-slate-100 pt-6">
            {tier.features.map((f) => (
              <li class="flex items-start gap-2 text-sm text-slate-600">
                <svg class="mt-0.5 h-4 w-4 flex-none text-accent" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path d="M5 12l4 4L19 6" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
                <span>{f}</span>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <p class="mt-8 text-center text-sm font-medium text-slate-500">{FOUNDING_NOTE}</p>
  </div>
</section>
