---
import { SITE } from '../config';
---

<section class="border-b border-slate-200/70">
  <div class="mx-auto max-w-content px-5 py-20 sm:px-8">
    <div class="rounded-2xl bg-slate-900 px-8 py-16 text-center sm:px-12">
      <h2 class="mx-auto max-w-2xl font-display text-2xl font-bold tracking-tight text-white sm:text-3xl">
        Stop opening calls cold. Know who's ready before you make one.
      </h2>
      <p class="mx-auto mt-4 max-w-xl text-lg text-slate-300">
        Build your first scorecard in minutes and let fit decide who gets a call.
      </p>
      <a
        href={SITE.signupUrl}
        class="mt-8 inline-flex items-center justify-center rounded-lg bg-accent px-6 py-3 text-base font-semibold text-white shadow-sm transition-colors hover:bg-accent-hover focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
      >
        Start free
      </a>
    </div>
  </div>
</section>
