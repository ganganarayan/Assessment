---
const cases = [
  {
    tag: 'B2B service firms',
    body: 'Replace the "quick intro call" with a scorecard that confirms fit before anyone books time on the calendar.',
  },
  {
    tag: 'Lead-gen & performance agencies',
    body: 'Turn cold ad traffic into scored, sales-ready leads your clients can act on the same day.',
  },
  {
    tag: 'Consultants qualifying fit',
    body: 'Screen inbound interest against your ideal engagement, and open every call already knowing the answer.',
  },
];
---

<section class="border-b border-slate-200/70">
  <div class="mx-auto max-w-content px-5 py-20 sm:px-8">
    <div class="max-w-2xl">
      <h2 class="font-display text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">
        Who runs on Assess360
      </h2>
      <p class="mt-4 text-lg text-slate-600">Teams whose next call is only worth making if the lead fits.</p>
    </div>

    <div class="mt-12 grid gap-6 md:grid-cols-3">
      {cases.map((c) => (
        <div class="flex flex-col rounded-xl border border-slate-200 bg-white p-7">
          <h3 class="font-display text-lg font-semibold text-slate-900">{c.tag}</h3>
          <p class="mt-3 leading-relaxed text-slate-600">{c.body}</p>
        </div>
      ))}
    </div>
  </div>
</section>
